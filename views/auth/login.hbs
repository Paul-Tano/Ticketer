<div class="min-h-screen bg-white flex flex-col md:flex-row font-sans text-gray-900">
  
  <!-- IMAGE COLUMN -->
  <div class="hidden md:block md:w-1/2 relative bg-black">
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
    <div class="absolute bottom-12 left-12 right-12 text-white">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight mb-4 drop-shadow-sm">Ressentez<br>La Basse.</h1>
      <p class="text-lg text-gray-300 font-medium max-w-md">Retrouvez l'énergie live et accédez à vos billets pour les prochains événements.</p>
    </div>
  </div>

  <!-- FORM COLUMN -->
  <div class="flex-1 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-20 xl:px-32">
    <div class="mx-auto w-full max-w-md">
    <div class="text-center mb-8">
      <a href="/" class="inline-block text-2xl font-black tracking-tight uppercase hover:opacity-70 transition-opacity mb-4">
        TICKETER.
      </a>
      <h2 class="text-4xl font-black tracking-tight uppercase mb-2">
        Bon retour
      </h2>
      <p class="font-mono text-[10px] uppercase tracking-widest text-gray-500 mb-2">
        Veuillez vous connecter pour retrouver vos billets.
      </p>
      <p class="font-mono text-[10px] uppercase tracking-widest text-gray-500">
        Nouveau ? 
        <a href="/register" class="text-black border-b border-black hover:text-gray-500 hover:border-gray-500 transition-colors pb-0.5 ml-1">
          S'inscrire
        </a>
      </p>
    </div>
  </div>

  <div class="mt-4 sm:mx-auto sm:w-full sm:max-w-md">
    
    {{#if error}}
    <div class="mb-8 border border-black p-4 flex items-start bg-[#F4F4F4]">
      <div class="flex-shrink-0 mt-0.5">
        <svg class="h-4 w-4 text-black" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-xs font-bold uppercase tracking-widest text-black mb-1">
          Erreur
        </h3>
        <div class="text-sm text-gray-600 font-medium">
          <p>{{error}}</p>
        </div>
      </div>
    </div>
    {{/if}}

    <div class="bg-white py-8 px-4 sm:px-10">
      <form class="space-y-8" action="/login" method="POST">
        
        <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
          <label for="email" class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
            Adresse email
          </label>
          <input id="email" name="email" type="email" autocomplete="email" required placeholder="vous@exemple.fr"
            class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none placeholder-gray-300">
        </div>

        <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
          <label for="password" class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
            Mot de passe
          </label>
          <input id="password" name="password" type="password" autocomplete="current-password" required placeholder="••••••••"
            class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none placeholder-gray-300">
        </div>
        <div class="pt-4">
          <button type="submit"
            class="w-full flex justify-center py-4 px-4 text-xs font-bold uppercase tracking-widest text-white bg-black hover:bg-gray-800 focus:outline-none transition-colors">
            Accéder
          </button>
        </div>
      </form>
    </div>
    </div>
  </div>
</div>

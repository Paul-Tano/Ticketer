<div class="min-h-screen bg-[#F8F9FA] font-sans text-gray-900 pb-24">
  <div class="max-w-7xl mx-auto pt-24 px-8 flex flex-col md:flex-row gap-16">
    
    <!-- Sidebar -->
    <aside class="w-full md:w-80 flex-shrink-0">
      <div class="bg-white p-8 shadow-2xl shadow-orange-500/5 border-t-8 border-orange-500 rounded-b-md">
        
        <!-- Info -->
        <div class="mb-8 border-b border-gray-200 pb-8 relative group">
          <p class="font-mono text-[10px] uppercase tracking-widest text-orange-600 mb-1">Identité <span class="text-[9px] text-gray-400 normal-case ml-2 opacity-0 group-hover:opacity-100 transition-opacity">(Cliquez pour modifier)</span></p>
          <h2 id="inline-username" contenteditable="true" spellcheck="false" class="text-3xl font-black tracking-tight uppercase text-black mb-1 drop-shadow-sm outline-none focus:border-b-2 focus:border-orange-500 focus:bg-orange-50 focus:text-orange-600 transition-colors hover:bg-gray-50 p-1 -ml-1 rounded-sm cursor-text">{{user.username}}</h2>
          <p id="inline-email" contenteditable="true" spellcheck="false" class="font-mono text-xs text-gray-500 outline-none focus:border-b-2 focus:border-orange-500 focus:bg-orange-50 focus:text-orange-600 transition-colors hover:bg-gray-50 p-1 -ml-1 rounded-sm cursor-text">{{user.email}}</p>
        </div>
        
        <!-- Actions -->
        <div class="space-y-4">
          <a href="/users/profile/edit" class="flex items-center justify-center gap-2 w-full text-center border border-gray-300 text-gray-600 font-black uppercase tracking-widest text-xs py-3 hover:bg-orange-600 hover:border-orange-600 hover:text-white hover:shadow-[0_10px_20px_rgba(234,88,12,0.2)] hover:-translate-y-0.5 transition-all rounded-sm">
            <i data-lucide="settings" class="w-4 h-4"></i> Paramètres
          </a>
        </div>

        <!-- Stats -->
        <div class="mt-8 pt-8 border-t border-gray-200 flex items-center justify-between">
          <span class="font-mono text-[10px] uppercase tracking-widest text-gray-500 flex items-center gap-1"><i data-lucide="heart" class="w-3 h-3 text-orange-500"></i> Favoris</span>
          <span class="bg-orange-600 text-white text-xs font-black px-3 py-1 shadow-md rounded-sm">{{countFavs}}</span>
        </div>

      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 space-y-12">
      
      <!-- Greeting -->
      <div class="bg-transparent pt-4">
        <p class="font-mono text-[10px] uppercase tracking-widest text-orange-600 mb-2 drop-shadow-sm">Tableau de bord</p>
        <h1 class="text-5xl font-black tracking-tight uppercase text-black drop-shadow-sm">Bonjour, <span id="greeting-name">{{user.username}}</span>.</h1>
      </div>

      <!-- Favorites -->
      <div class="bg-white border border-gray-200 shadow-xl shadow-black/5 rounded-md overflow-hidden">
        <div class="p-8 border-b border-gray-200 bg-[#F8F9FA]">
          <h3 class="text-2xl font-black tracking-tight uppercase text-black">Artistes Favoris</h3>
        </div>
        
        <div class="divide-y divide-gray-100">
          {{#each user.favoritBands}}
          <div class="p-8 flex items-center justify-between hover:bg-gray-50 transition-colors group">
            <div class="flex items-center gap-6">
              <!-- Minimal abstract initial box -->
              <div class="w-16 h-16 bg-[#F8F9FA] border border-gray-200 flex items-center justify-center text-orange-600 font-black text-2xl uppercase group-hover:border-orange-500 group-hover:shadow-md transition-all rounded-sm">
                {{this.name.[0]}}
              </div>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-gray-500 mb-1 group-hover:text-orange-500 transition-colors">Artiste</p>
                <h4 class="font-black text-lg uppercase tracking-tight text-black group-hover:text-orange-600 transition-colors">{{this.name}}</h4>
              </div>
            </div>
            
            <button class="text-gray-500 hover:text-red-500 transition-colors hover:scale-110" title="Retirer">
              <i data-lucide="trash-2" class="w-5 h-5"></i>
            </button>
          </div>
          {{else}}
          <div class="p-16 flex flex-col items-center justify-center text-center bg-white">
            <div class="w-12 h-12 border border-gray-200 flex items-center justify-center mb-4 text-gray-400 rounded-full">
              <i data-lucide="music-3" class="w-5 h-5"></i>
            </div>
            <p class="font-mono text-xs uppercase tracking-widest text-gray-500">Aucun artiste suivi.</p>
          </div>
          {{/each}}
        </div>
      </div>

    </main>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const inlineUsername = document.getElementById('inline-username');
    const inlineEmail = document.getElementById('inline-email');
    
    // Original values to prevent unnecessary requests
    let origUsername = inlineUsername ? inlineUsername.innerText.trim() : '';
    let origEmail = inlineEmail ? inlineEmail.innerText.trim() : '';

    function saveField(field, key, origValue) {
      const newValue = field.innerText.trim();
      
      // If nothing changed, do nothing
      if (newValue === origValue) return;

      // Make a PATCH request to update the profile
      fetch('/profile', {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ [key]: newValue })
      })
      .then(res => {
        if (!res.ok) {
          console.error("Erreur lors de la sauvegarde.");
          field.classList.add('text-red-500');
          setTimeout(() => field.classList.remove('text-red-500'), 2000);
        } else {
          // Success indicator
          field.classList.add('text-green-600');
          setTimeout(() => field.classList.remove('text-green-600'), 2000);
          
          if(key === 'username') {
             const greeting = document.getElementById('greeting-name');
             if(greeting) greeting.innerText = newValue;
             origUsername = newValue; // update orig
          } else if (key === 'email') {
             origEmail = newValue; // update orig
          }
        }
      })
      .catch(err => {
        console.error(err);
        field.classList.add('text-red-500');
        setTimeout(() => field.classList.remove('text-red-500'), 2000);
      });
    }

    [inlineUsername, inlineEmail].forEach(el => {
      if(!el) return;
      el.addEventListener('blur', function() {
        const key = this.id === 'inline-username' ? 'username' : 'email';
        const origValue = key === 'username' ? origUsername : origEmail;
        saveField(this, key, origValue);
      });
      
      // Save on enter
      el.addEventListener('keydown', function(e) {
        if(e.key === 'Enter') {
          e.preventDefault(); 
          this.blur(); // Trigger blur to save
        }
      });
    });
  });
</script>
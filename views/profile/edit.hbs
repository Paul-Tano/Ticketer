<div class="min-h-screen bg-[#F8F9FA] font-sans text-gray-900 pb-24">
  <div class="max-w-7xl mx-auto pt-24 px-8 flex flex-col md:flex-row gap-16">
    
    <!-- Sidebar -->
    <aside class="w-full md:w-80 flex-shrink-0">
      <div class="bg-white p-8 shadow-2xl shadow-orange-500/5 border-t-8 border-orange-500 rounded-b-md">
        
        <!-- Info -->
        <div class="mb-8 border-b border-gray-200 pb-8">
          <p class="font-mono text-[10px] uppercase tracking-widest text-orange-600 mb-1">Identité</p>
          <h2 class="text-3xl font-black tracking-tight uppercase text-black mb-1 drop-shadow-sm">{{user.username}}</h2>
          <p class="font-mono text-xs text-gray-500">{{user.email}}</p>
        </div>
        
        <!-- Actions -->
        <div class="space-y-4">
          <a href="/profile" class="flex items-center justify-center gap-2 w-full text-center border border-gray-300 text-gray-600 font-black uppercase tracking-widest text-xs py-3 hover:bg-orange-600 hover:border-orange-600 hover:text-white hover:shadow-[0_10px_20px_rgba(234,88,12,0.2)] hover:-translate-y-0.5 transition-all rounded-sm">
            <i data-lucide="user" class="w-4 h-4"></i> Mon Profil
          </a>
          <a href="/users/profile/edit" class="flex items-center justify-center gap-2 w-full text-center bg-orange-600 border border-orange-600 text-white font-black uppercase tracking-widest text-xs py-3 shadow-[0_10px_20px_rgba(234,88,12,0.2)] rounded-sm">
            <i data-lucide="settings" class="w-4 h-4"></i> Paramètres
          </a>
        </div>

      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 space-y-12">
      
      {{#if error}}
      <div class="mb-4 border border-red-500 p-4 flex items-start bg-red-50 rounded-sm">
        <div class="flex-shrink-0 mt-0.5">
          <i data-lucide="alert-circle" class="w-4 h-4 text-red-500"></i>
        </div>
        <div class="ml-3">
          <h3 class="text-xs font-bold uppercase tracking-widest text-red-700 mb-1">
            Erreur
          </h3>
          <div class="text-sm text-red-600 font-medium">
            <p>{{error}}</p>
          </div>
        </div>
      </div>
      {{/if}}

      <div class="bg-white border border-gray-200 shadow-xl shadow-black/5 rounded-md overflow-hidden">
        <div class="p-8 border-b border-gray-200 bg-[#F8F9FA]">
          <p class="font-mono text-[10px] uppercase tracking-widest text-orange-600 mb-2">Configuration</p>
          <h1 class="text-4xl font-black tracking-tight uppercase text-black">Paramètres du compte</h1>
        </div>

        <form action="/users/profile/update" method="POST" class="p-8 space-y-10">
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
            <!-- Username -->
            <div class="border-b border-gray-200 focus-within:border-orange-500 transition-colors relative pb-2 md:col-span-2">
              <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
                Nom d'utilisateur
              </label>
              <input type="text" name="username" value="{{user.username}}" required
                     class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none focus:text-orange-600 transition-colors">
            </div>

            <!-- Email -->
            <div class="border-b border-gray-200 focus-within:border-orange-500 transition-colors relative pb-2 md:col-span-2">
              <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
                Adresse Email
              </label>
              <input type="email" name="email" value="{{user.email}}" required
                     class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none focus:text-orange-600 transition-colors">
            </div>
            
            <!-- Old Password -->
            <div class="border-b border-gray-200 focus-within:border-orange-500 transition-colors relative pb-2 md:col-span-1 mt-4">
              <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
                Ancien mot de passe
              </label>
              <input type="password" name="oldPassword" placeholder="••••••••" 
                     class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none placeholder-gray-300 focus:text-orange-600 transition-colors">
              <p class="absolute -bottom-5 left-0 font-mono text-[9px] uppercase tracking-widest text-gray-400">Requis pour changer</p>
            </div>

            <!-- New Password -->
            <div class="border-b border-gray-200 focus-within:border-orange-500 transition-colors relative pb-2 md:col-span-1 mt-4">
              <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
                Nouveau mot de passe
              </label>
              <input type="password" name="password" placeholder="••••••••" 
                     class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none placeholder-gray-300 focus:text-orange-600 transition-colors">
              <p class="absolute -bottom-5 left-0 font-mono text-[9px] uppercase tracking-widest text-gray-400">Laisser vide si inchangé</p>
            </div>
          </div>

          <div class="pt-10 flex items-center justify-end gap-6 border-t border-gray-100 mt-8">
            <a href="/profile" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-orange-600 transition-colors">
              Annuler
            </a>
            <button type="submit" class="bg-black text-white font-bold uppercase tracking-widest text-xs px-10 py-4 hover:bg-orange-600 hover:shadow-[0_10px_20px_rgba(234,88,12,0.3)] hover:-translate-y-0.5 transition-all rounded-sm">
              Sauvegarder
            </button>
          </div>
        </form>
      </div>

    </main>
  </div>
</div>
<div class="min-h-screen bg-[#F4F4F4] font-sans text-gray-900 flex">

  <!-- Sidebar -->
  <aside class="fixed top-0 left-0 z-40 w-64 h-screen bg-white border-r border-gray-200">
    <div class="h-full px-6 py-10 overflow-y-auto flex flex-col">
      <div class="mb-12">
        <a href="/" class="block hover:opacity-80 transition-opacity">
          <span class="text-2xl font-black tracking-tight uppercase text-black">TICKETER.</span>
          <span class="block font-mono text-[10px] uppercase tracking-widest text-gray-400 mt-1">Espace Admin</span>
        </a>
        <a href="/" class="inline-flex items-center mt-6 text-[10px] font-mono uppercase tracking-widest text-gray-500 hover:text-orange-600 transition-colors">
          ← Retour au site
        </a>
      </div>
      
      <ul class="space-y-2 flex-1">
        <li>
          <a href="/admin" class="flex items-center px-4 py-3 text-gray-500 hover:text-black hover:bg-gray-50 font-mono text-xs uppercase tracking-widest transition-colors">
            Tableau de bord
          </a>
        </li>
        <li>
          <a href="/admin/bookings" class="flex items-center px-4 py-3 bg-black text-white font-mono text-xs uppercase tracking-widest transition-colors">
            <span class="w-2 h-2 bg-white mr-3"></span> Réservations
          </a>
        </li>
        <li>
          <a href="/admin/concerts" class="flex items-center px-4 py-3 text-gray-500 hover:text-black hover:bg-gray-50 font-mono text-xs uppercase tracking-widest transition-colors">
            Concerts
          </a>
        </li>
        <li>
          <a href="/admin/genres" class="flex items-center px-4 py-3 text-gray-500 hover:text-black hover:bg-gray-50 font-mono text-xs uppercase tracking-widest transition-colors">
            Genres
          </a>
        </li>
        <li>
          <a href="/admin/bands" class="flex items-center px-4 py-3 text-gray-500 hover:text-black hover:bg-gray-50 font-mono text-xs uppercase tracking-widest transition-colors">
            Groupes
          </a>
        </li>
        <li>
          <a href="/admin/users" class="flex items-center px-4 py-3 text-gray-500 hover:text-black hover:bg-gray-50 font-mono text-xs uppercase tracking-widest transition-colors">
            Utilisateurs
          </a>
        </li>
      </ul>

      <div class="mt-auto border-t border-gray-200 pt-6">
        <a href="/logout" class="flex items-center px-4 py-3 text-red-500 hover:bg-red-50 font-mono text-xs uppercase tracking-widest transition-colors">
          Déconnexion
        </a>
      </div>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="ml-64 p-12 w-full max-w-7xl">
    
    <div class="mb-12 flex items-end justify-between">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400 mb-2">Logs de transactions</p>
        <h1 class="text-4xl font-black tracking-tight uppercase text-black mb-4">Réservations</h1>
        
        <!-- Tabs -->
        <div class="flex gap-4">
          <a href="/admin/bookings?status=valide" class="font-bold text-xs uppercase tracking-widest pb-2 border-b-2 {{#if (eq status 'valide')}}border-black text-black{{else}}border-transparent text-gray-400 hover:text-black{{/if}} transition-colors">
            Actives
          </a>
          <a href="/admin/bookings?status=annulé" class="font-bold text-xs uppercase tracking-widest pb-2 border-b-2 {{#if (eq status 'annulé')}}border-red-600 text-red-600{{else}}border-transparent text-gray-400 hover:text-red-600{{/if}} transition-colors">
            Annulées
          </a>
        </div>
      </div>
      
      <!-- Search Form -->
      <form action="/admin/bookings" method="GET" class="flex items-center gap-2">
        <input type="text" name="search" value="{{search}}" placeholder="Rechercher (Utilisateur, Concert...)" class="border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-black w-64">
        <button type="submit" class="bg-black text-white px-4 py-2 text-sm font-bold uppercase tracking-widest hover:bg-gray-800 transition-colors">Chercher</button>
        <a href="/admin/bookings" class="border border-gray-300 text-gray-600 hover:bg-gray-50 px-4 py-2 text-sm font-bold uppercase tracking-widest transition-colors inline-flex items-center" title="Rafraîchir">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        </a>
      </form>
    </div>

    <!-- Bookings Table -->
    <div class="bg-white border border-gray-200 shadow-sm overflow-hidden mb-8">
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead class="border-b border-gray-200 bg-gray-50 font-mono text-[10px] uppercase tracking-widest text-gray-500">
            <tr>
              <th class="px-6 py-4 font-normal">Utilisateur</th>
              <th class="px-6 py-4 font-normal">Concert</th>
              <th class="px-6 py-4 font-normal">Date d'achat</th>
              <th class="px-6 py-4 font-normal text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {{#each bookings}}
            <tr class="hover:bg-gray-50 transition-colors group">
              <td class="px-6 py-4">
                <p class="font-bold text-sm text-black">{{user_id.username}}</p>
              </td>
              <td class="px-6 py-4">
                <p class="text-sm text-gray-600 font-medium">{{concert_id.title}}</p>
              </td>
              <td class="px-6 py-4">
                <p class="font-mono text-[10px] uppercase tracking-widest text-gray-500">{{formattedDate}}</p>
              </td>
              <td class="px-6 py-4 text-right opacity-0 group-hover:opacity-100 transition-opacity">
                {{#if (eq ../status 'valide')}}
                <button type="button" class="delete-btn text-red-600 hover:text-red-800 font-mono text-[10px] uppercase tracking-widest px-3 py-1 bg-red-50 hover:bg-red-100 border border-red-200 transition-colors rounded-sm" data-action="/admin/bookings/{{_id}}/delete">
                  Annuler
                </button>
                {{else}}
                <span class="text-gray-400 font-mono text-[10px] uppercase tracking-widest">Annulée</span>
                {{/if}}
              </td>
            </tr>
            {{else}}
            <tr>
              <td colspan="4" class="px-6 py-12 text-center text-gray-500 font-mono text-xs uppercase tracking-widest">
                Aucune réservation trouvée.
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    {{#if totalPages}}
    <div class="flex justify-center gap-2">
      {{#each pages}}
        <a href="/admin/bookings?page={{this}}{{#if ../search}}&search={{../search}}{{/if}}&status={{../status}}" 
           class="w-8 h-8 flex items-center justify-center border text-sm font-bold transition-colors
           {{#isNot this ../currentPage}}bg-white border-gray-200 text-gray-600 hover:border-black{{else}}bg-black border-black text-white{{/isNot}}">
          {{this}}
        </a>
      {{/each}}
    </div>
    {{/if}}

  </main>
</div>
<div class="min-h-screen bg-[#F4F4F4] font-sans text-gray-900 flex">
  <!-- Minimal Sidebar -->
  <aside class="fixed top-0 left-0 z-40 w-64 h-screen bg-white border-r border-gray-200">
    <div class="h-full px-6 py-10 flex flex-col">
      <a href="/admin" class="mb-12">
        <span class="text-2xl font-black tracking-tight uppercase text-black">TICKETER.</span>
        <span class="block font-mono text-[10px] uppercase tracking-widest text-gray-400 mt-1">Espace Admin</span>
      </a>
      <a href="/admin/users" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-black transition-colors mb-4">
        ← Retour aux Utilisateurs
      </a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="ml-64 p-12 w-full max-w-4xl">
    <div class="mb-12">
      <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400 mb-2">Base de données</p>
      <h1 class="text-4xl font-black tracking-tight uppercase text-black">Créer un Utilisateur</h1>
    </div>

    {{#if error}}
    <div class="mb-8 border border-black p-4 flex items-start bg-[#F4F4F4]">
      <div class="flex-shrink-0 mt-0.5">
        <svg class="h-4 w-4 text-black" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-xs font-bold uppercase tracking-widest text-black mb-1">
          Erreur
        </h3>
        <div class="text-sm text-gray-600 font-medium">
          <p>{{error}}</p>
        </div>
      </div>
    </div>
    {{/if}}

    <div class="bg-white border border-gray-200 shadow-sm p-8">
      <form action="/admin/users/create" method="POST" class="space-y-8">
        
        <div class="grid grid-cols-1 gap-8">
          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Nom d'utilisateur
            </label>
            <input type="text" name="username" placeholder="Alex Dubois" required
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Email
            </label>
            <input type="email" name="email" placeholder="alex@exemple.fr" required
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Rôle
            </label>
            <select name="role" required class="w-full text-black bg-transparent text-sm font-bold pt-6 pb-2 outline-none appearance-none cursor-pointer">
              <option value="user">Utilisateur Standard</option>
              <option value="admin">Administrateur</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-8 mt-8">
          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Mot de passe
            </label>
            <input type="password" name="password" placeholder="••••••••" required
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Confirmation du mot de passe
            </label>
            <input type="password" name="confirm" placeholder="••••••••" required
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>
        </div>

        <div class="flex items-center gap-6 pt-6">
          <button type="submit" class="bg-black text-white font-bold uppercase tracking-widest text-xs px-10 py-4 hover:bg-gray-800 transition-colors">
            Créer l'utilisateur
          </button>
          <a href="/admin/users" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-black transition-colors border-b border-transparent hover:border-black pb-0.5">
            Annuler
          </a>
        </div>
      </form>
    </div>
  </main>
</div>

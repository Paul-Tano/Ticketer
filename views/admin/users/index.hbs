<div class="min-h-screen bg-[#F4F4F4] font-sans text-gray-900 flex">

  <!-- Sidebar -->
  <aside class="fixed top-0 left-0 z-40 w-64 h-screen bg-white border-r border-gray-200">
    <div class="h-full px-6 py-10 overflow-y-auto flex flex-col">
      <a href="/" class="mb-12">
        <span class="text-2xl font-black tracking-tight uppercase text-black">TICKETER.</span>
        <span class="block font-mono text-[10px] uppercase tracking-widest text-gray-400 mt-1">Espace Admin</span>
      </a>
      
      <ul class="space-y-2 flex-1">
        <li>
          <a href="/admin" class="flex items-center px-4 py-3 text-gray-500 hover:text-black hover:bg-gray-50 font-mono text-xs uppercase tracking-widest transition-colors">
            Tableau de bord
          </a>
        </li>
        <li>
          <a href="/admin/bookings" class="flex items-center px-4 py-3 text-gray-500 hover:text-black hover:bg-gray-50 font-mono text-xs uppercase tracking-widest transition-colors">
            Réservations
          </a>
        </li>
        <li>
          <a href="/admin/concerts" class="flex items-center px-4 py-3 text-gray-500 hover:text-black hover:bg-gray-50 font-mono text-xs uppercase tracking-widest transition-colors">
            Concerts
          </a>
        </li>
        <li>
          <a href="/admin/genres" class="flex items-center px-4 py-3 text-gray-500 hover:text-black hover:bg-gray-50 font-mono text-xs uppercase tracking-widest transition-colors">
            Genres
          </a>
        </li>
        <li>
          <a href="/admin/bands" class="flex items-center px-4 py-3 text-gray-500 hover:text-black hover:bg-gray-50 font-mono text-xs uppercase tracking-widest transition-colors">
            Groupes
          </a>
        </li>
        <li>
          <a href="/admin/users" class="flex items-center px-4 py-3 bg-black text-white font-mono text-xs uppercase tracking-widest transition-colors">
            <span class="w-2 h-2 bg-white mr-3"></span> Utilisateurs
          </a>
        </li>
      </ul>

      <div class="mt-auto border-t border-gray-200 pt-6">
        <a href="/logout" class="flex items-center px-4 py-3 text-red-500 hover:bg-red-50 font-mono text-xs uppercase tracking-widest transition-colors">
          Déconnexion
        </a>
      </div>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="ml-64 p-12 w-full max-w-7xl">
    
    <div class="mb-12 flex items-end justify-between">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400 mb-2">Base de données</p>
        <h1 class="text-4xl font-black tracking-tight uppercase text-black">Utilisateurs</h1>
      </div>
      <a href="/register" class="bg-black text-white text-xs font-bold uppercase tracking-widest px-6 py-3 hover:bg-gray-800 transition-colors">
        Nouveau compte
      </a>
    </div>

    <!-- Users Table -->
    <div class="bg-white border border-gray-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead class="border-b border-gray-200 bg-gray-50 font-mono text-[10px] uppercase tracking-widest text-gray-500">
            <tr>
              <th class="px-6 py-4 font-normal">Identifiant</th>
              <th class="px-6 py-4 font-normal">Email</th>
              <th class="px-6 py-4 font-normal">Administrateur</th>
              <th class="px-6 py-4 font-normal">Suspendu</th>
              <th class="px-6 py-4 font-normal text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {{#each users}}
            <tr class="hover:bg-gray-50 transition-colors group {{#if (eq status 'suspended')}}bg-red-50/50{{/if}}">
              <td class="px-6 py-4 font-bold text-sm text-black">{{username}}</td>
              <td class="px-6 py-4 text-sm text-gray-600">{{email}}</td>
              <td class="px-6 py-4">
                <form id="role_{{_id}}" action="/users/role" method="POST" class="m-0">
                  <label class="relative flex items-center cursor-pointer group w-fit">
                    <input type="hidden" name="id" value="{{_id}}">
                    <input 
                      onchange="document.getElementById('role_{{_id}}').submit()"
                      type="checkbox" 
                      class="sr-only peer" 
                      value="" {{#if (eq role 'admin')}}checked{{/if}} />
                    <!-- Minimal toggle design -->
                    <div class="w-10 h-5 bg-gray-200 peer-focus:outline-none rounded-none peer peer-checked:bg-black transition-colors after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-full peer-checked:after:border-white"></div>
                  </label>
                </form>
              </td>
              <td class="px-6 py-4">
                <form id="status_{{_id}}" action="/users/status" method="POST" class="m-0">
                  <label class="relative flex items-center cursor-pointer group w-fit">
                    <input type="hidden" name="id" value="{{_id}}">
                    <input 
                      onchange="document.getElementById('status_{{_id}}').submit()"
                      type="checkbox" 
                      class="sr-only peer" 
                      value="" {{#if (eq status 'suspended')}}checked{{/if}} />
                    <!-- Minimal toggle design (red when checked) -->
                    <div class="w-10 h-5 bg-gray-200 peer-focus:outline-none rounded-none peer peer-checked:bg-red-500 transition-colors after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-full peer-checked:after:border-white"></div>
                  </label>
                </form>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
                  <a href="/users/{{_id}}/edit" class="text-[10px] font-mono uppercase tracking-widest text-black hover:bg-gray-100 border border-transparent hover:border-gray-300 px-3 py-1 transition-colors">
                    Éditer
                  </a>
                  <button type="button" class="delete-btn text-[10px] font-mono uppercase tracking-widest text-red-600 hover:bg-red-50 border border-transparent hover:border-red-200 px-3 py-1 transition-colors" data-action="/users/delete/{{_id}}">
                    Supprimer
                  </button>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>
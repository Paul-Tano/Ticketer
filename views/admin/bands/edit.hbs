<div class="min-h-screen bg-[#F4F4F4] font-sans text-gray-900 flex">
  <!-- Minimal Sidebar -->
  <aside class="fixed top-0 left-0 z-40 w-64 h-screen bg-white border-r border-gray-200">
    <div class="h-full px-6 py-10 flex flex-col">
      <div class="mb-12">
        <a href="/" class="block hover:opacity-80 transition-opacity">
          <span class="text-2xl font-black tracking-tight uppercase text-black">TICKETER.</span>
          <span class="block font-mono text-[10px] uppercase tracking-widest text-gray-400 mt-1">Espace Admin</span>
        </a>
        <a href="/" class="inline-flex items-center mt-6 text-[10px] font-mono uppercase tracking-widest text-gray-500 hover:text-orange-600 transition-colors">
          ← Retour au site
        </a>
      </div>
      <a href="/admin/bands" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-black transition-colors mb-4">
        ← Retour aux Groupes
      </a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="ml-64 p-12 w-full max-w-3xl">
    <div class="mb-12">
      <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400 mb-2">Base de données</p>
      <h1 class="text-4xl font-black tracking-tight uppercase text-black">Éditer Groupe</h1>
    </div>

    <div class="bg-white border border-gray-200 shadow-sm p-8">
      <form action="/admin/bands/update/{{band._id}}" method="POST" enctype="multipart/form-data" class="space-y-8">
        <input type="hidden" name="_method" value="PUT">
        <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
          <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
            Nom du Groupe
          </label>
          <input type="text" name="name" value="{{band.name}}" required placeholder="Ex: Tiken Jah Fakoly"
                 class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
        </div>

        <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
          <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
            Description
          </label>
          <textarea name="description" placeholder="Courte biographie..." rows="4"
                 class="w-full bg-transparent text-sm pt-6 pb-2 outline-none">{{band.description}}</textarea>
        </div>

        <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
          <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
            Image Officielle
          </label>
          {{#if band.image}}
            <img src="{{band.image}}" alt="{{band.name}}" class="h-16 w-16 object-cover mb-4">
          {{/if}}
          <input type="file" name="image" accept="image/*"
                 class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          <p class="font-mono text-[9px] text-gray-400 mt-1">Laissez vide si inchangé</p>
        </div>

        <div class="flex items-center gap-6 pt-4">
          <button type="submit" class="bg-black text-white font-bold uppercase tracking-widest text-xs px-10 py-4 hover:bg-gray-800 transition-colors">
            Mettre à jour
          </button>
          <a href="/admin/bands" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-black transition-colors border-b border-transparent hover:border-black pb-0.5">
            Annuler
          </a>
        </div>
      </form>
    </div>
  </main>
</div>
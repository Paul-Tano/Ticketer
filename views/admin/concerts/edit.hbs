<div class="min-h-screen bg-[#F4F4F4] font-sans text-gray-900 flex">
  <!-- Minimal Sidebar -->
  <aside id="admin-sidebar" class="fixed top-0 left-0 z-40 w-64 h-screen bg-white border-r border-gray-200 transform -translate-x-full md:translate-x-0 transition-transform duration-300">
    <div class="h-full px-6 py-10 flex flex-col">
      <div class="mb-12">
        <a href="/" class="block hover:opacity-80 transition-opacity">
          <span class="text-2xl font-black tracking-tight uppercase text-black">TICKETER.</span>
          <span class="block font-mono text-[10px] uppercase tracking-widest text-gray-400 mt-1">Espace Admin</span>
        </a>
        <a href="/" class="inline-flex items-center mt-6 text-[10px] font-mono uppercase tracking-widest text-gray-500 hover:text-orange-600 transition-colors">
          ← Retour au site
        </a>
      </div>
      <a href="/admin/concerts" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-black transition-colors mb-4">
        ← Retour aux Concerts
      </a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="md:ml-64 p-6 md:p-12 w-full max-w-4xl">
    <!-- Mobile Header -->
    <div class="md:hidden flex items-center justify-between mb-6 bg-white p-4 rounded-sm shadow-sm border border-gray-200">
      <span class="text-xl font-black tracking-tight uppercase text-black">TICKETER.</span>
      <button id="admin-menu-btn" class="text-gray-900 focus:outline-none">
        <i data-lucide="menu" class="w-6 h-6"></i>
      </button>
    </div>
    <!-- Overlay for mobile -->
    <div id="admin-sidebar-overlay" class="fixed inset-0 bg-black/50 z-30 hidden md:hidden backdrop-blur-sm transition-opacity"></div>

    <div class="mb-12">
      <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400 mb-2">Base de données</p>
      <h1 class="text-4xl font-black tracking-tight uppercase text-black">Éditer Concert</h1>
    </div>

    <div class="bg-white border border-gray-200 shadow-sm p-8">
      <form action="/admin/concerts/{{concert._id}}/update" method="POST" enctype="multipart/form-data" class="space-y-8">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2 md:col-span-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Titre de l'événement
            </label>
            <input type="text" name="title" value="{{concert.title}}" required placeholder="Ex: Summer Tour 2026"
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Artiste / Groupe
            </label>
            <select name="band_id" required class="w-full text-black bg-transparent text-sm font-bold pt-6 pb-2 outline-none appearance-none cursor-pointer">
              {{#each bands}}
                <option value="{{this._id}}" {{#if (eq this._id ../concert.band_id._id)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Genre
            </label>
            <select name="genre_id" required class="w-full text-black bg-transparent text-sm font-bold pt-6 pb-2 outline-none appearance-none cursor-pointer">
              {{#each genres}}
                <option value="{{this._id}}" {{#if (eq this._id ../concert.genre_id._id)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Lieu
            </label>
            <input type="text" name="location" value="{{concert.location}}" required placeholder="Ex: Accor Arena"
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2 md:col-span-1">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Date
            </label>
            <input type="date" name="date" value="{{concert.formattedDateInput}}" required
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2 md:col-span-1">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Heure de début
            </label>
            <input type="time" name="time" value="{{concert.time}}" required
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Prix du billet (FCFA)
            </label>
            <input type="number" name="price" value="{{concert.price}}" required placeholder="Ex: 45"
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Total des billets
            </label>
            <input type="number" id="totalTickets" name="totalTickets" value="{{concert.totalTickets}}" required placeholder="Ex: 5000" min="1"
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Billets disponibles
            </label>
            <input type="number" id="availableTickets" name="availableTickets" value="{{concert.availableTickets}}" required placeholder="Ex: 5000" min="0" max="{{concert.totalTickets}}"
                   class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none">
          </div>

          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2 md:col-span-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Changer l'image (Optionnel)
            </label>
            {{#if concert.image}}
              <div class="mt-6 mb-4">
                <img src="{{concert.image}}" alt="Affiche du concert" class="w-32 h-32 object-cover border border-gray-200">
              </div>
            {{/if}}
            <input type="file" name="image" accept="image/*"
                   class="w-full bg-transparent text-sm font-bold {{#unless concert.image}}pt-6{{/unless}} pb-2 outline-none cursor-pointer">
          </div>
          
          <div class="border-b border-gray-200 focus-within:border-black transition-colors relative pb-2 md:col-span-2">
            <label class="absolute top-0 left-0 font-mono text-[10px] uppercase tracking-widest text-gray-400">
              Description
            </label>
            <textarea name="description" rows="4" required placeholder="Description de l'événement..."
                      class="w-full bg-transparent text-sm font-bold pt-6 pb-2 outline-none resize-none">{{concert.description}}</textarea>
          </div>
        </div>

        <div class="flex items-center gap-6 pt-6">
          <button type="submit" class="bg-black text-white font-bold uppercase tracking-widest text-xs px-10 py-4 hover:bg-gray-800 transition-colors">
            Mettre à jour
          </button>
          <a href="/admin/concerts" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-black transition-colors border-b border-transparent hover:border-black pb-0.5">
            Annuler
          </a>
        </div>
      </form>
    </div>
  </main>
</div>

<script>
  document.querySelector('form').addEventListener('submit', function(e) {
    const totalTickets = parseInt(document.getElementById('totalTickets').value);
    const availableTickets = parseInt(document.getElementById('availableTickets').value);
    if (availableTickets > totalTickets) {
      e.preventDefault();
      alert("Le nombre de tickets disponibles ne peut pas dépasser le nombre total de tickets.");
    }
  });

  document.getElementById('totalTickets').addEventListener('input', function(e) {
    document.getElementById('availableTickets').max = e.target.value;
  });
</script>

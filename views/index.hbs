<div class="bg-[#F8F9FA] min-h-screen font-sans text-gray-900 pb-24">

  <!-- HERO SECTION -->
  <section class="relative pt-40 pb-48 px-8 flex flex-col items-center justify-center text-center overflow-hidden bg-[url('https://images.unsplash.com/photo-1540039155732-d68a9f390059?q=80&w=2938&auto=format&fit=crop')] bg-cover bg-center bg-no-repeat">
    <!-- Cinematic Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/80 to-black/30"></div>
    
    <div class="relative z-10 max-w-5xl mx-auto mt-12">
      <p class="font-mono text-xs uppercase tracking-widest text-orange-500 mb-6 drop-shadow-md">Underground Access</p>
      <h1 class="text-6xl md:text-8xl font-black tracking-tight leading-[0.9] mb-8 uppercase text-white drop-shadow-2xl">
        Vivez le Live.
      </h1>
      <p class="text-xl text-gray-200 mb-16 max-w-2xl mx-auto font-medium drop-shadow-lg">
        Réservez vos accès pour les artistes les plus convoités. L'expérience commence ici.
      </p>

      <!-- Glass Search Form inside Hero -->
      <form action="/concerts" method="GET" class="bg-white/5 backdrop-blur-2xl border border-white/10 text-white flex flex-col md:flex-row items-center justify-between p-2 shadow-2xl shadow-black/50 max-w-4xl mx-auto rounded-sm">
        <div class="flex items-center flex-1 px-4 py-3 md:py-0 w-full md:w-auto border-b md:border-b-0 md:border-r border-white/10 focus-within:bg-white/5 transition-colors">
          <i data-lucide="search" class="w-4 h-4 text-gray-400 mr-3"></i>
          <input type="text" name="search" placeholder="Artiste, tournée..." class="w-full bg-transparent text-sm font-bold outline-none placeholder-gray-400 text-white">
        </div>
        
        <div class="flex items-center flex-1 px-4 py-3 md:py-0 w-full md:w-auto border-b md:border-b-0 md:border-r border-white/10 focus-within:bg-white/5 transition-colors">
          <i data-lucide="music" class="w-4 h-4 text-gray-400 mr-3"></i>
          <select name="genre_id" class="w-full bg-transparent text-sm font-bold outline-none cursor-pointer appearance-none text-gray-400 focus:text-white">
            <option value="" class="bg-zinc-900 text-white">Tous les genres</option>
            {{#each Allgenres}}
              <option value="{{this._id}}" class="bg-zinc-900 text-white">{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="flex items-center flex-1 px-4 py-3 md:py-0 w-full md:w-auto border-b md:border-b-0 md:border-r border-white/10 focus-within:bg-white/5 transition-colors">
          <i data-lucide="mic" class="w-4 h-4 text-gray-400 mr-3"></i>
          <select name="band_id" class="w-full bg-transparent text-sm font-bold outline-none cursor-pointer appearance-none text-gray-400 focus:text-white">
            <option value="" class="bg-zinc-900 text-white">Artistes</option>
            {{#each bands}}
              <option value="{{this._id}}" class="bg-zinc-900 text-white">{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="flex items-center flex-1 px-4 py-3 md:py-0 w-full md:w-auto focus-within:bg-white/5 transition-colors">
          <i data-lucide="calendar" class="w-4 h-4 text-gray-400 mr-3"></i>
          <input type="date" name="date" class="w-full bg-transparent text-sm font-bold outline-none text-gray-400 focus:text-white [color-scheme:dark]">
        </div>

        <button type="submit" class="bg-orange-600 text-white text-xs font-black uppercase tracking-widest px-8 py-4 w-full md:w-auto hover:bg-orange-700 hover:shadow-[0_10px_20px_rgba(234,88,12,0.3)] hover:-translate-y-0.5 transition-all">
          Chercher
        </button>
      </form>
    </div>
  </section>

  <!-- FEATURES SECTION (Editorial minimal) -->
  <section class="py-32 px-8 bg-[#F8F9FA] border-b border-gray-200">
    <div class="max-w-7xl mx-auto">
      <div class="mb-20 flex flex-col md:flex-row md:items-end justify-between">
        <div>
          <h2 class="text-5xl font-black tracking-tight uppercase text-black">Avantages.</h2>
        </div>
        <p class="font-mono text-xs uppercase tracking-widest text-orange-600 mt-4 md:mt-0">Pourquoi choisir Ticketer</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="border-t border-gray-300 pt-6">
          <p class="font-mono text-[10px] text-gray-400 mb-4 tracking-widest">01 / SECURE</p>
          <h3 class="text-2xl font-bold tracking-tight mb-4 text-black">Paiement blindé</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Transactions cryptées de bout en bout. Payez vos billets en toute sécurité via notre infrastructure certifiée.</p>
        </div>
        <div class="border-t border-gray-300 pt-6">
          <p class="font-mono text-[10px] text-gray-400 mb-4 tracking-widest">02 / EVERYWHERE</p>
          <h3 class="text-2xl font-bold tracking-tight mb-4 text-black">Achat instantané</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Réservez vos tickets en ligne de n'importe où, à n'importe quel moment, et recevez votre QR code immédiatement.</p>
        </div>
        <div class="border-t border-gray-300 pt-6">
          <p class="font-mono text-[10px] text-gray-400 mb-4 tracking-widest">03 / FAIR</p>
          <h3 class="text-2xl font-bold tracking-tight mb-4 text-black">Prix garanti</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Aucun frais caché. Nous vous garantissons le meilleur tarif disponible sur l'ensemble de notre programmation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- URGENT SECTION -->
  <section class="py-32 px-8 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between">
        <div>
          <h2 class="text-5xl font-black tracking-tight uppercase text-black">Dernière chance.</h2>
          <p class="text-gray-500 text-lg mt-4 font-medium">Réservez avant qu'il ne soit trop tard.</p>
        </div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-red-600 mt-4 md:mt-0 border border-red-200 bg-red-50 px-3 py-1">Fast Selling</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {{#each urgentConcerts}}
          <a href="/concerts/{{this._id}}" class="group relative block w-full aspect-[4/5] overflow-hidden bg-white shadow-xl shadow-black/5 hover:shadow-2xl hover:shadow-black/10 hover:-translate-y-2 transition-all duration-500 rounded-md">
            <img src="{{this.image}}" alt="{{this.title}}" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-110 group-hover:opacity-100 transition-all duration-700 ease-out">
            
            <!-- Dark Gradient Overlay for readability -->
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
            
            <!-- Badges -->
            <div class="absolute top-4 left-4 flex flex-col gap-2 z-10">
              {{#if this.isSoldOut}}
                <span class="bg-black/80 backdrop-blur text-white text-[10px] font-mono tracking-widest uppercase px-3 py-1 border border-white/20">Sold Out</span>
              {{else}}
                <span class="bg-orange-600 text-white text-[10px] font-black tracking-widest uppercase px-3 py-1 shadow-md">En Vente</span>
              {{/if}}
            </div>

            <!-- Content -->
            <div class="absolute bottom-0 left-0 w-full p-6 z-10 flex flex-col justify-end">
              <p class="text-[10px] font-mono tracking-widest uppercase text-orange-500 mb-2 drop-shadow-md">{{this.band_id.name}}</p>
              <h3 class="font-black text-2xl tracking-tight text-white mb-2 leading-tight group-hover:text-orange-400 transition-colors drop-shadow-xl">{{this.title}}</h3>
              <p class="text-xs text-gray-300 flex items-center gap-1 opacity-80"><i data-lucide="map-pin" class="w-3 h-3"></i> {{this.location}}</p>
            </div>
          </a>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS SECTION -->
  <section class="py-32 px-8 bg-[#F8F9FA] border-y border-gray-200">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row items-center gap-20">
        
        <div class="flex-1">
          <p class="font-mono text-xs uppercase tracking-widest text-orange-600 mb-4">Process</p>
          <h2 class="text-5xl font-black tracking-tight text-black mb-8 leading-[1.1] uppercase">
            Le pass en 4 clics.
          </h2>
          <p class="text-gray-600 text-lg mb-10 leading-relaxed font-medium">
            Parcourez. Sélectionnez. Validez. Scannez. Notre infrastructure réduit les frictions pour que vous puissiez vous concentrer sur l'expérience live.
          </p>
          <a href="/concerts" class="inline-block bg-black text-white text-xs font-black uppercase tracking-widest px-8 py-4 hover:bg-gray-800 hover:-translate-y-0.5 hover:shadow-lg transition-all rounded-sm">
            Voir le programme
          </a>
        </div>

        <div class="flex-1 w-full bg-white aspect-square flex items-center justify-center p-12 border border-gray-200 rounded-full overflow-hidden relative shadow-2xl shadow-orange-600/5">
           <!-- Placeholder for abstract minimal tech illustration instead of generic svg -->
           <div class="absolute inset-0 bg-gradient-to-tr from-orange-500/5 to-transparent"></div>
           <div class="w-full h-full border-2 border-gray-200 border-dashed flex flex-col items-center justify-center opacity-50 relative z-10 rounded-full animate-spin-slow" style="animation-duration: 40s;">
              <div class="w-48 h-48 rounded-full border border-orange-500/30 mb-4 flex items-center justify-center">
                 <div class="w-24 h-24 bg-orange-500/20 blur-xl rounded-full"></div>
              </div>
           </div>
           <p class="absolute font-mono text-xs uppercase tracking-widest text-black z-20">Data.Flow</p>
        </div>

      </div>
    </div>
  </section>

  <!-- UPCOMING CONCERTS -->
  <section class="py-32 px-8 bg-[#F8F9FA]">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between border-b border-gray-200 pb-4">
        <h2 class="text-3xl font-black tracking-tight text-black uppercase">À venir</h2>
        <a href="/concerts" class="font-mono text-[10px] uppercase tracking-widest text-orange-600 hover:text-black transition-colors mt-4 md:mt-0">Tout voir →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {{#each upcomingConcerts}}
          <a href="/concerts/{{this._id}}" class="group relative block aspect-square overflow-hidden bg-white shadow-xl shadow-black/5 hover:shadow-2xl hover:shadow-black/10 hover:-translate-y-2 transition-all duration-500 rounded-md">
            <img src="/{{this.image}}" alt="{{this.title}}" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-110 group-hover:opacity-100 transition-transform duration-700 ease-out">
            
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>

            <span class="absolute top-4 right-4 bg-white/10 backdrop-blur-md text-white text-[10px] font-mono tracking-widest uppercase px-3 py-1 border border-white/20 z-10">
              Incoming
            </span>

            <div class="absolute bottom-0 left-0 w-full p-5 z-10">
              <p class="text-[10px] font-mono tracking-widest uppercase text-orange-500 mb-1 drop-shadow-md">{{this.band_id.name}}</p>
              <h3 class="font-bold text-lg tracking-tight text-white mb-2 truncate group-hover:text-orange-400 transition-colors drop-shadow-lg">{{this.title}}</h3>
              <div class="flex justify-between items-center text-[10px] text-gray-300">
                <span class="truncate flex items-center gap-1 opacity-80"><i data-lucide="map-pin" class="w-3 h-3"></i> {{this.location}}</span>
                <span class="font-mono flex items-center gap-1 opacity-80"><i data-lucide="calendar" class="w-3 h-3"></i> {{this.formattedDate}}</span>
              </div>
            </div>
          </a>
        {{/each}}
      </div>
    </div>
  </section>

</div>
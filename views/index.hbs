<div class="bg-[#F8F9FA] min-h-screen font-sans text-gray-900 pb-24">

  <!-- HERO SECTION -->
  <section class="relative pt-40 pb-48 px-8 flex flex-col items-center justify-center text-center overflow-hidden bg-zinc-950">
    <!-- Video Background -->
    <video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover z-0 opacity-80">
      <source src="/videos/hero-bg.mp4" type="video/mp4">
    </video>

    <!-- Cinematic Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/80 to-black/30 z-0"></div>
    
    <div class="relative z-10 max-w-5xl mx-auto mt-12">
      <p class="font-mono text-xs uppercase tracking-widest text-orange-500 mb-6 drop-shadow-md">Accès Exclusif</p>
      <h1 class="text-6xl md:text-8xl font-black tracking-tight leading-[0.9] mb-8 uppercase text-white drop-shadow-2xl">
        Vivez le Live.
      </h1>
      <p class="text-xl text-gray-200 mb-16 max-w-2xl mx-auto font-medium drop-shadow-lg">
        Réservez vos accès pour les artistes les plus convoités. L'expérience commence ici.
      </p>

      <!-- Glass Search Form inside Hero -->
      <form action="/concerts" method="GET" class="bg-white/5 backdrop-blur-2xl border border-white/10 text-white flex flex-col md:flex-row items-center justify-between p-2 shadow-2xl shadow-black/50 max-w-4xl mx-auto rounded-sm">
        <div class="flex items-center flex-1 px-4 py-3 md:py-0 w-full md:w-auto border-b md:border-b-0 md:border-r border-white/10 focus-within:bg-white/5 transition-colors">
          <i data-lucide="search" class="w-4 h-4 text-gray-400 mr-3"></i>
          <input type="text" name="search" placeholder="Artiste, tournée..." class="w-full bg-transparent text-sm font-bold outline-none placeholder-gray-400 text-white">
        </div>
        
        <div class="flex items-center flex-1 px-4 py-3 md:py-0 w-full md:w-auto border-b md:border-b-0 md:border-r border-white/10 focus-within:bg-white/5 transition-colors">
          <i data-lucide="music" class="w-4 h-4 text-gray-400 mr-3"></i>
          <select name="genre_id" class="w-full bg-transparent text-sm font-bold outline-none cursor-pointer appearance-none text-gray-400 focus:text-white">
            <option value="" class="bg-zinc-900 text-white">Tous les genres</option>
            {{#each Allgenres}}
              <option value="{{this._id}}" class="bg-zinc-900 text-white">{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="flex items-center flex-1 px-4 py-3 md:py-0 w-full md:w-auto border-b md:border-b-0 md:border-r border-white/10 focus-within:bg-white/5 transition-colors">
          <i data-lucide="mic" class="w-4 h-4 text-gray-400 mr-3"></i>
          <select name="band_id" class="w-full bg-transparent text-sm font-bold outline-none cursor-pointer appearance-none text-gray-400 focus:text-white">
            <option value="" class="bg-zinc-900 text-white">Artistes</option>
            {{#each bands}}
              <option value="{{this._id}}" class="bg-zinc-900 text-white">{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="flex items-center flex-1 px-4 py-3 md:py-0 w-full md:w-auto focus-within:bg-white/5 transition-colors">
          <i data-lucide="calendar" class="w-4 h-4 text-gray-400 mr-3"></i>
          <input type="date" name="date" class="w-full bg-transparent text-sm font-bold outline-none text-gray-400 focus:text-white [color-scheme:dark]">
        </div>

        <button type="submit" class="bg-orange-600 text-white text-xs font-black uppercase tracking-widest px-8 py-4 w-full md:w-auto hover:bg-orange-700 hover:shadow-[0_10px_20px_rgba(234,88,12,0.3)] hover:-translate-y-0.5 transition-all">
          Chercher
        </button>
      </form>
    </div>
  </section>

  <!-- FEATURES SECTION (Editorial minimal) -->
  <section class="py-32 px-8 bg-[#F8F9FA] border-b border-gray-200">
    <div class="max-w-7xl mx-auto">
      <div class="mb-20 flex flex-col md:flex-row md:items-end justify-between">
        <div>
          <h2 class="text-5xl font-black tracking-tight uppercase text-black">Avantages.</h2>
        </div>
        <p class="font-mono text-xs uppercase tracking-widest text-orange-600 mt-4 md:mt-0">Pourquoi choisir Ticketer</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="border-t border-gray-300 pt-6">
          <p class="font-mono text-[10px] text-gray-400 mb-4 tracking-widest">01 / SÉCURISÉ</p>
          <h3 class="text-2xl font-bold tracking-tight mb-4 text-black">Paiement blindé</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Transactions cryptées de bout en bout. Payez vos billets en toute sécurité via notre infrastructure certifiée.</p>
        </div>
        <div class="border-t border-gray-300 pt-6">
          <p class="font-mono text-[10px] text-gray-400 mb-4 tracking-widest">02 / PARTOUT</p>
          <h3 class="text-2xl font-bold tracking-tight mb-4 text-black">Achat instantané</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Réservez vos tickets en ligne de n'importe où, à n'importe quel moment, et recevez votre QR code immédiatement.</p>
        </div>
        <div class="border-t border-gray-300 pt-6">
          <p class="font-mono text-[10px] text-gray-400 mb-4 tracking-widest">03 / ÉQUITABLE</p>
          <h3 class="text-2xl font-bold tracking-tight mb-4 text-black">Prix garanti</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Aucun frais caché. Nous vous garantissons le meilleur tarif disponible sur l'ensemble de notre programmation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- URGENT SECTION -->
  <section class="py-32 px-8 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between">
        <div>
          <h2 class="text-5xl font-black tracking-tight uppercase text-black">Dernière chance.</h2>
          <p class="text-gray-500 text-lg mt-4 font-medium">Réservez avant qu'il ne soit trop tard.</p>
        </div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-red-600 mt-4 md:mt-0 border border-red-200 bg-red-50 px-3 py-1">Vente Rapide</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {{#each urgentConcerts}}
          <a href="/concerts/{{this._id}}" class="group relative block w-full aspect-[4/5] overflow-hidden bg-white shadow-xl shadow-black/5 hover:shadow-2xl hover:shadow-black/10 hover:-translate-y-2 transition-all duration-500 rounded-md">
            <img src="{{this.image}}" alt="{{this.title}}" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-110 group-hover:opacity-100 transition-all duration-700 ease-out">
            
            <!-- Dark Gradient Overlay for readability -->
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
            
            <!-- Badges -->
            <div class="absolute top-4 left-4 flex flex-col gap-2 z-10">
              {{#if this.isSoldOut}}
                <span class="bg-black/80 backdrop-blur text-white text-[10px] font-mono tracking-widest uppercase px-3 py-1 border border-white/20">Épuisé</span>
              {{else}}
                <span class="bg-orange-600 text-white text-[10px] font-black tracking-widest uppercase px-3 py-1 shadow-md">En Vente</span>
              {{/if}}
            </div>

            <!-- Content -->
            <div class="absolute bottom-0 left-0 w-full p-6 z-10 flex flex-col justify-end">
              <p class="text-[10px] font-mono tracking-widest uppercase text-orange-500 mb-2 drop-shadow-md">{{this.band_id.name}}</p>
              <h3 class="font-black text-2xl tracking-tight text-white mb-2 leading-tight group-hover:text-orange-400 transition-colors drop-shadow-xl">{{this.title}}</h3>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 text-[10px] text-white mt-2">
                <span class="truncate flex items-center gap-1 opacity-80"><i data-lucide="map-pin" class="w-3 h-3"></i> {{this.location}}</span>
                <span class="font-mono flex items-center gap-1 opacity-80"><i data-lucide="calendar" class="w-3 h-3"></i> {{this.formattedDate}}</span>
              </div>
            </div>
          </a>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS SECTION (Typographic) -->
  <section class="py-32 px-8 bg-zinc-950 text-white border-y border-zinc-900">
    <div class="max-w-7xl mx-auto">
      <div class="mb-24 text-center max-w-3xl mx-auto">
        <p class="font-mono text-xs uppercase tracking-widest text-orange-500 mb-4">Processus</p>
        <h2 class="text-5xl md:text-7xl font-black tracking-tight mb-8 leading-[1] uppercase drop-shadow-lg">
          Zéro Friction.
        </h2>
        <p class="text-gray-400 text-lg leading-relaxed font-medium">
          De la découverte à l'entrée dans la salle, notre plateforme est conçue pour être invisible. Concentrez-vous uniquement sur le son.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-6 relative">
        <!-- Connecting Line -->
        <div class="hidden md:block absolute top-12 left-[12.5%] right-[12.5%] h-px bg-zinc-800 z-0"></div>
        
        <!-- Step 1 -->
        <div class="relative z-10 flex flex-col items-center text-center group">
          <div class="w-24 h-24 bg-zinc-950 border-2 border-zinc-800 rounded-full flex items-center justify-center mb-8 group-hover:border-orange-500 group-hover:shadow-[0_0_30px_rgba(234,88,12,0.2)] transition-all duration-500">
            <span class="font-black text-4xl text-white group-hover:text-orange-500 transition-colors">1</span>
          </div>
          <h3 class="font-bold text-xl uppercase tracking-tight mb-3">Explorez</h3>
          <p class="text-xs text-gray-500 leading-relaxed font-mono px-4">Parcourez notre sélection pointue d'artistes et de lieux.</p>
        </div>

        <!-- Step 2 -->
        <div class="relative z-10 flex flex-col items-center text-center group">
          <div class="w-24 h-24 bg-zinc-950 border-2 border-zinc-800 rounded-full flex items-center justify-center mb-8 group-hover:border-orange-500 group-hover:shadow-[0_0_30px_rgba(234,88,12,0.2)] transition-all duration-500 delay-75">
            <span class="font-black text-4xl text-white group-hover:text-orange-500 transition-colors">2</span>
          </div>
          <h3 class="font-bold text-xl uppercase tracking-tight mb-3">Réservez</h3>
          <p class="text-xs text-gray-500 leading-relaxed font-mono px-4">Sécurisez votre place en deux clics via notre infrastructure.</p>
        </div>

        <!-- Step 3 -->
        <div class="relative z-10 flex flex-col items-center text-center group">
          <div class="w-24 h-24 bg-zinc-950 border-2 border-zinc-800 rounded-full flex items-center justify-center mb-8 group-hover:border-orange-500 group-hover:shadow-[0_0_30px_rgba(234,88,12,0.2)] transition-all duration-500 delay-150">
            <span class="font-black text-4xl text-white group-hover:text-orange-500 transition-colors">3</span>
          </div>
          <h3 class="font-bold text-xl uppercase tracking-tight mb-3">Recevez</h3>
          <p class="text-xs text-gray-500 leading-relaxed font-mono px-4">Obtenez instantanément votre pass ou QR code numérique.</p>
        </div>

        <!-- Step 4 -->
        <div class="relative z-10 flex flex-col items-center text-center group">
          <div class="w-24 h-24 bg-zinc-950 border-2 border-zinc-800 rounded-full flex items-center justify-center mb-8 group-hover:border-orange-500 group-hover:shadow-[0_0_30px_rgba(234,88,12,0.2)] transition-all duration-500 delay-200">
            <span class="font-black text-4xl text-white group-hover:text-orange-500 transition-colors">4</span>
          </div>
          <h3 class="font-bold text-xl uppercase tracking-tight mb-3">Vivez</h3>
          <p class="text-xs text-gray-500 leading-relaxed font-mono px-4">Faites scanner votre pass et profitez de l'expérience live.</p>
        </div>
      </div>
      
      <div class="mt-24 text-center">
         <a href="/concerts" class="inline-block bg-orange-600 text-white text-xs font-black uppercase tracking-widest px-10 py-5 hover:bg-orange-500 hover:shadow-[0_10px_30px_rgba(234,88,12,0.4)] hover:-translate-y-1 transition-all rounded-sm">
            Voir le programme
          </a>
      </div>
    </div>
  </section>

  <!-- ARTIST CAROUSEL SECTION -->
  <section class="py-32 px-8 bg-black text-white">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between border-b border-zinc-900 pb-4">
        <h2 class="text-3xl font-black tracking-tight uppercase text-white">Nos Artistes</h2>
        <a href="/artistes" class="font-mono text-[10px] uppercase tracking-widest text-orange-600 hover:text-white transition-colors mt-4 md:mt-0">Tout voir  </a>
      </div>
      <style>
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
      </style>
      <div id="artistsCarousel" class="flex overflow-x-auto gap-8 pb-8 snap-x snap-mandatory scrollbar-hide relative scroll-smooth">
        {{#each allBands}}
          <a href="/artistes/{{this._id}}" class="snap-start shrink-0 w-64 group block relative overflow-hidden bg-zinc-900 aspect-[3/4]">
            {{#if this.image}}
              <img src="{{this.image}}" alt="{{this.name}}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-70 group-hover:opacity-100">
            {{else}}
              <div class="absolute inset-0 flex items-center justify-center bg-zinc-800">
                <i data-lucide="mic-2" class="w-12 h-12 text-zinc-600"></i>
              </div>
            {{/if}}
            
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-90 group-hover:opacity-100 transition-opacity"></div>
            
            <div class="absolute bottom-0 left-0 p-6 w-full transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
              <h3 class="text-xl font-black text-white uppercase tracking-tight">{{this.name}}</h3>
              <p class="text-orange-500 font-mono text-[10px] uppercase tracking-widest mt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">Voir le profil  </p>
            </div>
          </a>
        {{/each}}
      </div>

      <!-- Navigation Indicators -->
      <div id="carouselIndicators" class="flex justify-center gap-3 mt-4">
        {{#each allBands}}
          <button class="w-3 h-3 rounded-full bg-zinc-700 hover:bg-orange-500 transition-colors" aria-label="Aller à l'artiste {{@index}}"></button>
        {{/each}}
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const carousel = document.getElementById('artistsCarousel');
      const indicatorsContainer = document.getElementById('carouselIndicators');
      if (!carousel) return;
      
      const items = Array.from(carousel.children);
      const indicators = indicatorsContainer ? Array.from(indicatorsContainer.children) : [];
      let autoScrollInterval;

      function updateIndicators() {
        if (!items.length) return;
        const scrollLeft = carousel.scrollLeft;
        const itemWidth = items[0].offsetWidth + 32; 
        const activeIndex = Math.round(scrollLeft / itemWidth);
        
        indicators.forEach((ind, idx) => {
          if (idx === activeIndex) {
            ind.classList.remove('bg-zinc-700');
            ind.classList.add('bg-orange-500');
          } else {
            ind.classList.remove('bg-orange-500');
            ind.classList.add('bg-zinc-700');
          }
        });
      }

      function startAutoScroll() {
        if (autoScrollInterval) clearInterval(autoScrollInterval);
        autoScrollInterval = setInterval(() => {
          if (!items.length) return;
          const itemWidth = items[0].offsetWidth + 32; 
          
          if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 10) {
            carousel.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            carousel.scrollBy({ left: itemWidth, behavior: 'smooth' });
          }
        }, 3000);
      }

      indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
          if (!items.length) return;
          const itemWidth = items[0].offsetWidth + 32;
          carousel.scrollTo({ left: itemWidth * index, behavior: 'smooth' });
          startAutoScroll();
        });
      });

      carousel.addEventListener('scroll', () => {
        updateIndicators();
      });

      updateIndicators();
      startAutoScroll();
    });
  </script>

  <!-- UPCOMING CONCERTS -->
  <section class="py-32 px-8 bg-[#F8F9FA]">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between border-b border-gray-200 pb-4">
        <h2 class="text-3xl font-black tracking-tight text-black uppercase">À venir</h2>
        <a href="/concerts" class="font-mono text-[10px] uppercase tracking-widest text-orange-600 hover:text-black transition-colors mt-4 md:mt-0">Tout voir  </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {{#each upcomingConcerts}}
          <a href="/concerts/{{this._id}}" class="group relative block aspect-square overflow-hidden bg-white shadow-xl shadow-black/5 hover:shadow-2xl hover:shadow-black/10 hover:-translate-y-2 transition-all duration-500 rounded-md">
            <img src="{{this.image}}" alt="{{this.title}}" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-110 group-hover:opacity-100 transition-transform duration-700 ease-out">
            
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>

            <span class="absolute top-4 right-4 bg-white/10 backdrop-blur-md text-white text-[10px] font-mono tracking-widest uppercase px-3 py-1 border border-white/20 z-10">
              À Venir
            </span>

            <div class="absolute bottom-0 left-0 w-full p-5 z-10">
              <p class="text-[10px] font-mono tracking-widest uppercase text-orange-500 mb-1 drop-shadow-md">{{this.band_id.name}}</p>
              <h3 class="font-bold text-lg tracking-tight text-white mb-2 truncate group-hover:text-orange-400 transition-colors drop-shadow-lg">{{this.title}}</h3>
              <div class="flex justify-between items-center text-[10px] text-gray-300">
                <span class="truncate flex items-center gap-1 opacity-80"><i data-lucide="map-pin" class="w-3 h-3"></i> {{this.location}}</span>
                <span class="font-mono flex items-center gap-1 opacity-80"><i data-lucide="calendar" class="w-3 h-3"></i> {{this.formattedDate}}</span>
              </div>
            </div>
          </a>
        {{/each}}
      </div>
    </div>
  </section>

</div>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TICKETER</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                // Keeping original brand config if needed by backend or plugins, but using minimal palette for UI
                50: '#eef2ff',
                100: '#e0e7ff',
                200: '#c7d2fe',
                300: '#a5b4fc',
                400: '#818cf8',
                500: '#6366f1',
                600: '#4f46e5',
                700: '#4338ca',
                800: '#3730a3',
                900: '#312e81',
                950: '#1e1b4b',
              }
            },
            fontFamily: {
              sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'sans-serif'],
            }
          }
        }
      }
    </script>

    <style>
        .flatpickr-calendar {
            background: white !important;
            border-radius: 0 !important;
            border: 1px solid #e5e7eb !important;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.1) !important;
            font-family: inherit !important;
        }
        .flatpickr-day.selected {
            background: black !important;
            border-color: black !important;
        }
    </style>
</head>

<body class="bg-[#F8F9FA] font-sans text-gray-900 antialiased mx-auto selection:bg-orange-500 selection:text-white">
  
  {{#if globalError}}
  <div class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] w-[90%] max-w-md bg-red-50 border border-red-200 p-4 shadow-xl">
    <div class="flex items-start">
      <div class="flex-shrink-0 mt-0.5">
        <i data-lucide="alert-circle" class="h-4 w-4 text-red-500"></i>
      </div>
      <div class="ml-3 flex-1">
        <h3 class="text-xs font-bold uppercase tracking-widest text-red-800 mb-1">
          Erreur de validation
        </h3>
        <div class="text-sm text-red-600 font-medium">
          <p>{{{globalError}}}</p>
        </div>
      </div>
      <div class="ml-4 flex-shrink-0 flex">
        <button type="button" class="bg-red-50 rounded-md inline-flex text-red-500 hover:text-red-600 focus:outline-none" onclick="this.parentElement.parentElement.parentElement.style.display='none'">
          <span class="sr-only">Fermer</span>
          <i data-lucide="x" class="h-4 w-4"></i>
        </button>
      </div>
    </div>
  </div>
  {{/if}}

{{#if (and (isNot currentRouteName 'register') (isNot currentRouteName 'login') (isNot currentRouteName 'admin'))}}    
    <!-- MINIMAL EDITORIAL NAVBAR -->
    <nav class="sticky top-0 w-full z-50 bg-white/80 backdrop-blur-xl border-b border-gray-200 px-4 md:px-8 py-4 transition-all shadow-sm">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            
            <!-- Mobile Menu Toggle (Left) -->
            <div class="md:hidden w-1/3 flex justify-start">
                <button id="mobile-menu-btn" class="text-gray-900 hover:text-orange-600 focus:outline-none p-2 -ml-2">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
            </div>

            <!-- Left Links (Desktop) -->
            <div class="hidden md:flex items-center gap-8 w-1/3">
                <a href="/" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-orange-600 transition-colors">Accueil</a>
                <a href="/concerts" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-orange-600 transition-colors">Programme</a>
                <a href="/artistes" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-orange-600 transition-colors">Artistes</a>
            </div>
            
            <!-- Center Brand -->
            <div class="w-1/3 flex justify-center">
                <a href="/" class="text-2xl font-black tracking-tight uppercase text-black hover:text-orange-600 transition-colors drop-shadow-sm">
                    TICKETER.
                </a>
            </div>
            
            <!-- Right Actions (Desktop) -->
            <div class="hidden md:flex items-center justify-end gap-6 w-1/3">
                {{#if user}}
                    <a href="/bookings" class="text-gray-400 hover:text-orange-600 transition-colors" title="Mes Réservations">
                        <i data-lucide="ticket" class="w-5 h-5"></i>
                    </a>
                    
                    <a href="/notifications" class="relative text-gray-400 hover:text-orange-600 transition-colors" title="Notifications">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                        {{#if unreadNotifsCount}}
                            <span class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-orange-500 border-2 border-white shadow-sm text-[8px] font-bold text-white">{{unreadNotifsCount}}</span>
                        {{/if}}
                    </a>
                    
                    {{#if (eq user.role 'admin')}}
                    <a href="/admin" class="text-gray-400 hover:text-orange-600 transition-colors" title="Dashboard">
                        <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                    </a>
                    {{/if}}

                    <a href="/profile" class="flex items-center gap-2 group">
                        <div class="h-8 w-8 rounded-full overflow-hidden border border-gray-200 group-hover:border-orange-500 transition-colors bg-gray-50 flex items-center justify-center shadow-sm group-hover:shadow-[0_0_15px_rgba(234,88,12,0.2)]">
                            <span class="text-[10px] font-bold uppercase text-gray-900">{{user.username}}</span>
                        </div>
                    </a>
                    
                    <a href="/logout" class="text-xs font-mono uppercase tracking-widest text-gray-400 hover:text-red-600 transition-colors">
                        Se déconnecter  
                    </a>
                {{else}}
                    <a href="/login" class="bg-orange-600 text-white text-[10px] md:text-xs font-black uppercase tracking-widest px-6 py-2.5 hover:bg-orange-700 hover:shadow-[0_10px_20px_rgba(234,88,12,0.3)] hover:-translate-y-0.5 transition-all rounded-sm">
                        S'identifier
                    </a>
                {{/if}}
            </div>

            <!-- Empty right space for mobile to center brand -->
            <div class="md:hidden w-1/3 flex justify-end">
                {{#if user}}
                     <a href="/profile" class="flex items-center gap-2 group">
                        <div class="h-8 w-8 rounded-full overflow-hidden border border-gray-200 bg-gray-50 flex items-center justify-center shadow-sm">
                            <span class="text-[10px] font-bold uppercase text-gray-900">{{user.username}}</span>
                        </div>
                    </a>
                {{/if}}
            </div>
        </div>
    </nav>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 bg-white/95 backdrop-blur-xl z-40 transform -translate-x-full transition-transform duration-300 md:hidden flex flex-col pt-24 px-8 pb-8 shadow-2xl overflow-y-auto">
        <div class="flex flex-col gap-8 text-center">
            <a href="/" class="text-3xl font-black uppercase tracking-tight hover:text-orange-600 transition-colors">Accueil</a>
            <a href="/concerts" class="text-3xl font-black uppercase tracking-tight hover:text-orange-600 transition-colors">Programme</a>
            <a href="/artistes" class="text-3xl font-black uppercase tracking-tight hover:text-orange-600 transition-colors">Artistes</a>
            
            <div class="w-16 h-px bg-gray-300 mx-auto my-4"></div>
            
            {{#if user}}
                {{#if (eq user.role 'admin')}}
                <a href="/admin" class="text-xl font-bold uppercase tracking-tight text-gray-600 hover:text-orange-600 transition-colors">Dashboard Admin</a>
                {{/if}}
                <a href="/bookings" class="text-xl font-bold uppercase tracking-tight text-gray-600 hover:text-orange-600 transition-colors">Mes Réservations</a>
                <a href="/profile" class="text-xl font-bold uppercase tracking-tight text-gray-600 hover:text-orange-600 transition-colors">Mon Profil</a>
                <a href="/logout" class="text-xl font-bold uppercase tracking-tight text-red-600 hover:text-red-700 transition-colors mt-4">Se déconnecter</a>
            {{else}}
                <a href="/login" class="inline-block bg-orange-600 text-white text-lg font-black uppercase tracking-widest px-8 py-4 hover:bg-orange-700 transition-all rounded-sm">
                    S'identifier
                </a>
            {{/if}}
        </div>
    </div>
{{/if}}

    <main class="min-h-screen">
        {{{body}}}
    </main>

<!-- MINIMAL EDITORIAL FOOTER -->
{{#if (and (isNot currentRouteName 'register') (isNot currentRouteName 'login') (isNot currentRouteName 'admin'))}}    
    <footer class="bg-black text-white pt-24 pb-12 border-t-8 border-gray-900">
        <div class="max-w-7xl mx-auto px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-16 mb-24">
                
                <!-- Brand Info -->
                <div class="md:col-span-1">
                    <div class="text-2xl font-black tracking-tight uppercase mb-6">TICKETER.</div>
                    <p class="text-gray-400 text-sm leading-relaxed mb-6">
                        La sélection des meilleures expériences live. Un son pur, des espaces parfaits.
                    </p>
                    <a href="mailto:contact@ticketer.com" class="text-xs font-mono uppercase tracking-widest text-white hover:text-gray-400 transition-colors border-b border-white hover:border-gray-400 pb-1">
                        contact@ticketer.com
                    </a>
                </div>

                <!-- Links -->
                <div>
                    <h4 class="font-mono text-[10px] uppercase tracking-widest text-gray-500 mb-6">Plateforme</h4>
                    <ul class="space-y-4 text-sm font-medium">
                        <li><a href="/" class="hover:text-gray-400 transition-colors">À propos</a></li>
                        <li><a href="/concerts" class="hover:text-gray-400 transition-colors">Programme Live</a></li>
                        <li><a href="#" class="hover:text-gray-400 transition-colors">Presse</a></li>
                    </ul>
                </div>
                
                <div>
                    <h4 class="font-mono text-[10px] uppercase tracking-widest text-gray-500 mb-6">Support</h4>
                    <ul class="space-y-4 text-sm font-medium">
                        <li><a href="#" class="hover:text-gray-400 transition-colors">Centre d'Aide</a></li>
                        <li><a href="#" class="hover:text-gray-400 transition-colors">Pour les Organisateurs</a></li>
                        <li><a href="#" class="hover:text-gray-400 transition-colors">Accessibilité</a></li>
                    </ul>
                </div>

                <!-- Newsletter -->
                <div>
                    <h4 class="font-mono text-[10px] uppercase tracking-widest text-gray-500 mb-6">Dispatch</h4>
                    <p class="text-gray-400 text-xs mb-4 leading-relaxed">
                        Recevez notre sélection hebdomadaire des meilleurs sets et lives.
                    </p>
                    <div class="flex items-center border-b border-gray-700 focus-within:border-orange-500 transition-colors pb-2 group">
                        <input type="email" placeholder="Adresse Email" class="bg-transparent text-sm w-full outline-none placeholder-gray-500 text-white">
                        <button class="text-[10px] font-mono uppercase tracking-widest text-gray-400 group-hover:text-orange-500 transition-colors ml-4 flex items-center gap-1">
                            Envoyer <i data-lucide="arrow-right" class="w-3 h-3"></i>
                        </button>
                    </div>
                </div>

            </div>

            <!-- Bottom Bar -->
            <div class="border-t border-gray-900 pt-8 flex flex-col md:flex-row items-center justify-between gap-6">
                <p class="font-mono text-[10px] uppercase tracking-widest text-gray-600">
                    &copy; 2026 TICKETER. TOUS DROITS RÉSERVÉS.
                </p>
                <div class="flex gap-8 font-mono text-[10px] uppercase tracking-widest text-gray-600">
                    <a href="#" class="hover:text-white transition-colors">CGU</a>
                    <a href="#" class="hover:text-white transition-colors">Confidentialité</a>
                    <a href="#" class="hover:text-white transition-colors">Cookies</a>
                </div>
            </div>
        </div>
    </footer>
{{/if}}

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        flatpickr("#concert-date", {
            locale: "fr",          
            dateFormat: "d-m-Y",    
            altFormat: "j F Y",     
            altInput: true,        
            allowInput: true,       
            placeholder: "Sélectionner une date",
            onChange: function(selectedDates, dateStr, instance) {
                console.log("Date sélectionnée:", dateStr);
            }
        });
    });
</script>
<script>
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener('click', () => {
            const isClosed = mobileMenu.classList.contains('-translate-x-full');
            if (isClosed) {
                mobileMenu.classList.remove('-translate-x-full');
                mobileMenu.classList.add('translate-x-0');
                mobileBtn.innerHTML = '<i data-lucide="x" class="w-6 h-6"></i>';
                lucide.createIcons();
                document.body.style.overflow = 'hidden';
            } else {
                mobileMenu.classList.add('-translate-x-full');
                mobileMenu.classList.remove('translate-x-0');
                mobileBtn.innerHTML = '<i data-lucide="menu" class="w-6 h-6"></i>';
                lucide.createIcons();
                document.body.style.overflow = '';
            }
        });
    }
</script>
<!-- GLOBAL DELETE MODAL -->
<div id="global-delete-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="bg-white max-w-sm w-full p-8 shadow-2xl relative translate-y-4 opacity-0 transition-all duration-300 transform scale-95" id="delete-modal-content">
        <div class="w-12 h-12 bg-red-50 border border-red-100 flex items-center justify-center mb-6">
            <i data-lucide="alert-triangle" class="w-6 h-6 text-red-600"></i>
        </div>
        <h3 class="text-2xl font-black uppercase tracking-tight text-black mb-2">Confirmation</h3>
        <p class="text-sm font-medium text-gray-500 mb-8 leading-relaxed">Cette action est irréversible. Êtes-vous sûr de vouloir supprimer cet élément ?</p>
        
        <form id="delete-modal-form" method="POST" class="flex flex-col gap-3">
            <button type="submit" class="w-full bg-red-600 text-white font-black uppercase tracking-widest text-xs py-4 hover:bg-red-700 transition-colors">
                Oui, supprimer
            </button>
            <button type="button" id="close-delete-modal" class="w-full bg-gray-100 text-black font-bold uppercase tracking-widest text-xs py-4 hover:bg-gray-200 transition-colors">
                Annuler
            </button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const deleteBtns = document.querySelectorAll('.delete-btn');
        const modal = document.getElementById('global-delete-modal');
        const modalContent = document.getElementById('delete-modal-content');
        const closeBtn = document.getElementById('close-delete-modal');
        const form = document.getElementById('delete-modal-form');

        function openModal(actionUrl) {
            form.action = actionUrl;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            // Animate in
            setTimeout(() => {
                modalContent.classList.remove('translate-y-4', 'opacity-0', 'scale-95');
                modalContent.classList.add('translate-y-0', 'opacity-100', 'scale-100');
            }, 10);
        }

        function closeModal() {
            // Animate out
            modalContent.classList.remove('translate-y-0', 'opacity-100', 'scale-100');
            modalContent.classList.add('translate-y-4', 'opacity-0', 'scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                form.action = '';
            }, 300);
        }

        deleteBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const actionUrl = btn.getAttribute('data-action');
                if (actionUrl) openModal(actionUrl);
            });
        });

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        
        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
        }
    });
</script>

<script>
  lucide.createIcons();

  // GLOBAL FORM TRIMMER: Empêcher les espaces vides dans tous les formulaires
  document.addEventListener('submit', function(e) {
    if (e.target && e.target.tagName === 'FORM') {
      const inputs = e.target.querySelectorAll('input[type="text"], input[type="email"], input[type="password"], textarea');
      inputs.forEach(input => {
        if (input.value) {
          input.value = input.value.trim();
        }
      });
    }
  });

  // ADMIN SIDEBAR TOGGLE
  const adminBtn = document.getElementById('admin-menu-btn');
  const adminSidebar = document.getElementById('admin-sidebar');
  const adminOverlay = document.getElementById('admin-sidebar-overlay');
  
  if (adminBtn && adminSidebar && adminOverlay) {
      function toggleAdminSidebar() {
          const isClosed = adminSidebar.classList.contains('-translate-x-full');
          if (isClosed) {
              adminSidebar.classList.remove('-translate-x-full');
              adminOverlay.classList.remove('hidden');
              document.body.style.overflow = 'hidden';
          } else {
              adminSidebar.classList.add('-translate-x-full');
              adminOverlay.classList.add('hidden');
              document.body.style.overflow = '';
          }
      }
      adminBtn.addEventListener('click', toggleAdminSidebar);
      adminOverlay.addEventListener('click', toggleAdminSidebar);
  }
</script>
</body>
</html>
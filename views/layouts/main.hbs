<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TICKETER</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                // Keeping original brand config if needed by backend or plugins, but using minimal palette for UI
                50: '#eef2ff',
                100: '#e0e7ff',
                200: '#c7d2fe',
                300: '#a5b4fc',
                400: '#818cf8',
                500: '#6366f1',
                600: '#4f46e5',
                700: '#4338ca',
                800: '#3730a3',
                900: '#312e81',
                950: '#1e1b4b',
              }
            },
            fontFamily: {
              sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'sans-serif'],
            }
          }
        }
      }
    </script>

    <style>
        .flatpickr-calendar {
            background: white !important;
            border-radius: 0 !important;
            border: 1px solid #e5e7eb !important;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.1) !important;
            font-family: inherit !important;
        }
        .flatpickr-day.selected {
            background: black !important;
            border-color: black !important;
        }
    </style>
</head>

<body class="bg-[#F8F9FA] font-sans text-gray-900 antialiased mx-auto selection:bg-orange-500 selection:text-white">
{{#if (and (isNot currentRouteName 'register') (isNot currentRouteName 'login') (isNot currentRouteName 'admin'))}}    
    <!-- MINIMAL EDITORIAL NAVBAR -->
    <nav class="sticky top-0 w-full z-50 bg-white/80 backdrop-blur-xl border-b border-gray-200 px-8 py-4 transition-all shadow-sm">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            
            <!-- Left Links -->
            <div class="flex items-center gap-8 w-1/3">
                <a href="/" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-orange-600 transition-colors">Accueil</a>
                <a href="/concerts" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-orange-600 transition-colors">Programme</a>
            </div>
            
            <!-- Center Brand -->
            <div class="w-1/3 flex justify-center">
                <a href="/" class="text-2xl font-black tracking-tight uppercase text-black hover:text-orange-600 transition-colors drop-shadow-sm">
                    TICKETER.
                </a>
            </div>
            
            <!-- Right Actions -->
            <div class="flex items-center justify-end gap-6 w-1/3">
                {{#if user}}
                    <!-- Connected -->
                    <a href="/bookings" class="text-gray-400 hover:text-orange-600 transition-colors" title="Mes Réservations">
                        <i data-lucide="ticket" class="w-5 h-5"></i>
                    </a>
                    
                    {{#if notifications}}
                        <a href="/notifications" class="relative text-gray-400 hover:text-orange-600 transition-colors">
                            <i data-lucide="bell" class="w-5 h-5"></i>
                            {{#if unreadCount}}
                                <span class="absolute -top-1 -right-1 flex h-3 w-3 items-center justify-center rounded-full bg-orange-500 border-2 border-white shadow-sm"></span>
                            {{/if}}
                        </a>
                    {{/if}}
                    
                    <a href="/profile" class="flex items-center gap-2 group">
                        <div class="h-8 w-8 rounded-full overflow-hidden border border-gray-200 group-hover:border-orange-500 transition-colors bg-gray-50 flex items-center justify-center shadow-sm group-hover:shadow-[0_0_15px_rgba(234,88,12,0.2)]">
                            <span class="text-[10px] font-bold uppercase text-gray-900">{{user.username}}</span>
                        </div>
                    </a>
                    
                    <a href="/logout" class="text-xs font-mono uppercase tracking-widest text-gray-400 hover:text-red-600 transition-colors">
                        Se déconnecter  
                    </a>
                {{else}}
                    <!-- Not connected -->
                    <a href="/login" class="bg-orange-600 text-white text-[10px] md:text-xs font-black uppercase tracking-widest px-6 py-2.5 hover:bg-orange-700 hover:shadow-[0_10px_20px_rgba(234,88,12,0.3)] hover:-translate-y-0.5 transition-all rounded-sm">
                        S'identifier
                    </a>
                {{/if}}
            </div>
        </div>
    </nav>
{{/if}}

    <main class="min-h-screen">
        {{{body}}}
    </main>

<!-- MINIMAL EDITORIAL FOOTER -->
{{#if (and (isNot currentRouteName 'register') (isNot currentRouteName 'login') (isNot currentRouteName 'admin'))}}    
    <footer class="bg-black text-white pt-24 pb-12 border-t-8 border-gray-900">
        <div class="max-w-7xl mx-auto px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-16 mb-24">
                
                <!-- Brand Info -->
                <div class="md:col-span-1">
                    <div class="text-2xl font-black tracking-tight uppercase mb-6">TICKETER.</div>
                    <p class="text-gray-400 text-sm leading-relaxed mb-6">
                        Curating the best live experiences. Pure sound, perfect spaces.
                    </p>
                    <a href="mailto:contact@ticketer.com" class="text-xs font-mono uppercase tracking-widest text-white hover:text-gray-400 transition-colors border-b border-white hover:border-gray-400 pb-1">
                        contact@ticketer.com
                    </a>
                </div>

                <!-- Links -->
                <div>
                    <h4 class="font-mono text-[10px] uppercase tracking-widest text-gray-500 mb-6">Plateforme</h4>
                    <ul class="space-y-4 text-sm font-medium">
                        <li><a href="/" class="hover:text-gray-400 transition-colors">À propos</a></li>
                        <li><a href="/concerts" class="hover:text-gray-400 transition-colors">Programme Live</a></li>
                        <li><a href="#" class="hover:text-gray-400 transition-colors">Presse</a></li>
                    </ul>
                </div>
                
                <div>
                    <h4 class="font-mono text-[10px] uppercase tracking-widest text-gray-500 mb-6">Support</h4>
                    <ul class="space-y-4 text-sm font-medium">
                        <li><a href="#" class="hover:text-gray-400 transition-colors">Centre d'Aide</a></li>
                        <li><a href="#" class="hover:text-gray-400 transition-colors">Pour les Organisateurs</a></li>
                        <li><a href="#" class="hover:text-gray-400 transition-colors">Accessibilité</a></li>
                    </ul>
                </div>

                <!-- Newsletter -->
                <div>
                    <h4 class="font-mono text-[10px] uppercase tracking-widest text-gray-500 mb-6">Dispatching</h4>
                    <p class="text-gray-400 text-xs mb-4 leading-relaxed">
                        Recevez notre sélection hebdomadaire des meilleurs sets et lives.
                    </p>
                    <div class="flex items-center border-b border-gray-700 focus-within:border-orange-500 transition-colors pb-2 group">
                        <input type="email" placeholder="Adresse Email" class="bg-transparent text-sm w-full outline-none placeholder-gray-500 text-white">
                        <button class="text-[10px] font-mono uppercase tracking-widest text-gray-400 group-hover:text-orange-500 transition-colors ml-4 flex items-center gap-1">
                            Submit <i data-lucide="arrow-right" class="w-3 h-3"></i>
                        </button>
                    </div>
                </div>

            </div>

            <!-- Bottom Bar -->
            <div class="border-t border-gray-900 pt-8 flex flex-col md:flex-row items-center justify-between gap-6">
                <p class="font-mono text-[10px] uppercase tracking-widest text-gray-600">
                    &copy; 2026 TICKETER. ALL RIGHTS RESERVED.
                </p>
                <div class="flex gap-8 font-mono text-[10px] uppercase tracking-widest text-gray-600">
                    <a href="#" class="hover:text-white transition-colors">Terms</a>
                    <a href="#" class="hover:text-white transition-colors">Privacy</a>
                    <a href="#" class="hover:text-white transition-colors">Cookies</a>
                </div>
            </div>
        </div>
    </footer>
{{/if}}

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        flatpickr("#concert-date", {
            locale: "fr",          
            dateFormat: "d-m-Y",    
            altFormat: "j F Y",     
            altInput: true,        
            allowInput: true,       
            placeholder: "Sélectionner une date",
            onChange: function(selectedDates, dateStr, instance) {
                console.log("Date sélectionnée:", dateStr);
            }
        });
    });
</script>
<script>
  lucide.createIcons();
</script>
</body>
</html>
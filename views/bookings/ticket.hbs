<div class="min-h-screen bg-[#F4F4F4] flex flex-col items-center py-12 px-4 sm:px-6 lg:px-8 font-sans">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <a href="/" class="inline-block text-2xl font-black tracking-tight uppercase text-black hover:opacity-70 transition-opacity mb-2">
        TICKETER.
      </a>
      <p class="font-mono text-[10px] uppercase tracking-widest text-gray-500">Contrôle des billets</p>
    </div>

    {{#if error}}
      <div class="bg-red-50 border border-red-200 p-8 text-center shadow-sm">
        <div class="w-16 h-16 bg-white border border-red-200 flex items-center justify-center mx-auto mb-6 rounded-sm">
          <i data-lucide="x-circle" class="w-8 h-8 text-red-500"></i>
        </div>
        <h2 class="text-2xl font-black uppercase tracking-tight text-red-600 mb-2">Erreur</h2>
        <p class="text-gray-600 font-medium">{{error}}</p>
      </div>
    {{else}}
      <div class="bg-white border border-gray-200 shadow-xl shadow-black/5 overflow-hidden">
        
        <!-- Status Header -->
        {{#if (eq ticket.status 'valide')}}
          <div class="bg-black text-white text-center py-4 border-b-4 border-orange-500">
            <h2 class="text-xl font-black uppercase tracking-widest">Billet Valide</h2>
          </div>
        {{else if (eq ticket.status 'scanné')}}
          <div class="bg-gray-100 text-gray-500 text-center py-4 border-b-4 border-gray-300">
            <h2 class="text-xl font-black uppercase tracking-widest">Déjà Scanné</h2>
          </div>
        {{else}}
          <div class="bg-red-50 text-red-600 text-center py-4 border-b-4 border-red-500">
            <h2 class="text-xl font-black uppercase tracking-widest">Billet Annulé</h2>
          </div>
        {{/if}}

        <div class="p-8">
          <!-- Concert Info -->
          <div class="mb-8 text-center">
            <h3 class="text-3xl font-black uppercase tracking-tight mb-2">{{ticket.concert_id.title}}</h3>
            <p class="text-lg text-gray-500 font-medium">{{ticket.concert_id.band_id.name}}</p>
          </div>

          <div class="space-y-6">
            <div class="flex items-start gap-4 pb-6 border-b border-gray-100">
              <div class="w-10 h-10 bg-gray-50 border border-gray-200 flex items-center justify-center flex-shrink-0">
                <i data-lucide="calendar" class="w-5 h-5 text-gray-400"></i>
              </div>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400 mb-1">Date & Heure</p>
                <p class="font-bold text-sm">{{formattedDate}}</p>
              </div>
            </div>

            <div class="flex items-start gap-4 pb-6 border-b border-gray-100">
              <div class="w-10 h-10 bg-gray-50 border border-gray-200 flex items-center justify-center flex-shrink-0">
                <i data-lucide="map-pin" class="w-5 h-5 text-gray-400"></i>
              </div>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400 mb-1">Lieu</p>
                <p class="font-bold text-sm">{{ticket.concert_id.location}}</p>
              </div>
            </div>

            <div class="flex items-start gap-4 pb-6 border-b border-gray-100">
              <div class="w-10 h-10 bg-gray-50 border border-gray-200 flex items-center justify-center flex-shrink-0">
                <i data-lucide="user" class="w-5 h-5 text-gray-400"></i>
              </div>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400 mb-1">Détenteur</p>
                <p class="font-bold text-sm">{{ticket.user_id.username}}</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-gray-50 border border-gray-200 flex items-center justify-center flex-shrink-0">
                <i data-lucide="hash" class="w-5 h-5 text-gray-400"></i>
              </div>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400 mb-1">Référence</p>
                <p class="font-mono font-bold text-xs">{{ticket._id}}</p>
              </div>
            </div>
          </div>
        </div>

        {{#if (eq ticket.status 'valide')}}
          <!-- Optionnel : Un bouton pour le contrôleur pour marquer comme scanné -->
          <div class="p-4 bg-gray-50 border-t border-gray-100">
            <form action="/tickets/scan/{{ticket._id}}" method="POST">
              <button type="submit" class="w-full bg-black text-white font-bold uppercase tracking-widest text-xs py-4 hover:bg-gray-800 transition-colors">
                Marquer comme scanné
              </button>
            </form>
          </div>
        {{/if}}

      </div>
    {{/if}}
  </div>
</div>

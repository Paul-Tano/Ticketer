<div class="bg-[#F8F9FA] min-h-screen pb-32 font-sans text-gray-900">
  <div class="max-w-5xl mx-auto pt-24 px-8">
    
    <div class="flex flex-col md:flex-row items-end justify-between mb-16 gap-8">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-orange-600 mb-2 drop-shadow-sm">Historique d'Accès</p>
        <h1 class="text-5xl font-black tracking-tight text-black uppercase">Mes Réservations</h1>
      </div>
      <a href="/concerts" class="text-xs font-bold uppercase tracking-widest border-b border-gray-300 pb-1 text-gray-500 hover:text-orange-600 hover:border-orange-600 transition-colors">
        Nouveaux Concerts
      </a>
    </div>

    <div>
      {{#if bookings}}
        <div class="space-y-12">
          {{#each bookings}}
            <!-- Skeuomorphic Ticket Container -->
            <div class="relative flex flex-col md:flex-row bg-white shadow-xl shadow-black/5 drop-shadow-sm w-full group border border-gray-200 rounded-md overflow-hidden">
              
              <!-- Zone 1: Image (Left) -->
              <div class="relative w-full md:w-1/4 h-48 md:h-auto overflow-hidden bg-[#F8F9FA] flex-shrink-0">
                <img src="{{this.concert_id.image}}" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-105 transition-all duration-700" alt="{{this.concert_id.title}}">
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                <div class="absolute bottom-6 left-6">
                  <span class="text-white bg-orange-600 text-[10px] font-black tracking-widest uppercase px-3 py-1 shadow-md">
                    {{this.concert_id.band_id.name}}
                  </span>
                </div>
              </div>
              
              <!-- Zone 2: Details (Center) with thick left border -->
              <div class="relative w-full md:w-1/2 p-8 md:p-10 flex flex-col justify-center bg-white border-l-[6px] border-orange-500">
                <h4 class="text-3xl font-black tracking-tight text-black uppercase leading-none mb-6 group-hover:text-orange-600 transition-colors">{{this.concert_id.title}}</h4>
                
                <div class="grid grid-cols-2 gap-6 mb-8">
                  <div>
                    <p class="font-mono text-[9px] uppercase tracking-widest text-gray-500 mb-1 group-hover:text-orange-500 transition-colors">Lieu</p>
                    <p class="text-sm font-bold text-gray-800">{{this.concert_id.location}}</p>
                  </div>
                  <div>
                    <p class="font-mono text-[9px] uppercase tracking-widest text-gray-500 mb-1 group-hover:text-orange-500 transition-colors">Date</p>
                    <p class="text-sm font-bold text-gray-800">{{this.concert_id.formattedDate}}</p>
                  </div>
                </div>
                
                <div class="mt-auto">
                  <p class="font-mono text-[10px] text-gray-400 uppercase tracking-widest">ID: {{this._id}}</p>
                </div>
              </div>

              <!-- Ticket Cutout Separator (Perforated lines & notches) -->
              <div class="hidden md:flex flex-col items-center justify-center relative w-8 bg-white overflow-hidden flex-shrink-0">
                <!-- Top Notch -->
                <div class="absolute top-[-16px] w-8 h-8 rounded-full bg-[#F8F9FA] shadow-inner border-b border-gray-200"></div>
                <!-- Dotted Line -->
                <div class="h-full w-0 border-l-2 border-dashed border-gray-200 my-4"></div>
                <!-- Bottom Notch -->
                <div class="absolute bottom-[-16px] w-8 h-8 rounded-full bg-[#F8F9FA] shadow-inner border-t border-gray-200"></div>
              </div>

              <!-- Zone 3: QR Code (Right) -->
              <div class="relative w-full md:w-1/4 bg-white p-8 flex flex-col items-center justify-center flex-shrink-0">
                <!-- Mobile notch simulation -->
                <div class="md:hidden absolute top-[-16px] left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-[#F8F9FA] shadow-inner z-10 border-b border-gray-200"></div>
                <div class="md:hidden absolute top-0 left-8 right-8 border-t-2 border-dashed border-gray-200"></div>

                <div class="bg-white p-2 border-2 border-gray-200 mb-4 group-hover:border-orange-500 group-hover:scale-105 group-hover:shadow-lg transition-all duration-300">
                  <img src="{{this.qrCode}}" alt="QR Code Billet" class="w-32 h-32 object-contain" style="image-rendering: pixelated;">
                </div>
                <p class="text-[10px] font-mono tracking-widest uppercase text-orange-500 font-bold drop-shadow-sm">Admit One</p>
              </div>

            </div>
          {{/each}}
        </div>
      {{else}}
        <!-- Empty State -->
        <div class="bg-white p-20 shadow-xl shadow-black/5 flex flex-col items-center justify-center text-center border-t-8 border-orange-500 rounded-b-md">
          <div class="w-16 h-16 border border-gray-200 flex items-center justify-center mb-6 rounded-full bg-[#F8F9FA]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
            </svg>
          </div>
          <h3 class="text-2xl font-black tracking-tight uppercase text-black mb-4">Portefeuille Vide</h3>
          <p class="text-gray-500 text-sm mb-8 max-w-sm">Aucun accès enregistré. Parcourez la programmation pour réserver vos prochaines expériences.</p>
          <a href="/concerts" class="bg-orange-600 text-white text-xs font-black uppercase tracking-widest px-8 py-3 rounded-sm hover:bg-orange-700 hover:shadow-lg hover:-translate-y-0.5 transition-all">
            Voir la programmation
          </a>
        </div>
      {{/if}}
    </div>

  </div>
</div>

<div class="bg-[#F8F9FA] min-h-screen pb-24 font-sans text-gray-900">
  
  <!-- Minimal Editorial Header -->
  <div class="max-w-7xl mx-auto px-8 pt-20 pb-12 flex flex-col md:flex-row items-end justify-between gap-8">
    <div class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-widest text-orange-600 mb-4 drop-shadow-sm">Programmations Live</p>
      <h1 class="text-6xl md:text-8xl font-black tracking-tight leading-none text-black">CONCERTS</h1>
    </div>
    <div class="text-right pb-2">
      <p class="text-sm text-gray-500 max-w-xs ml-auto leading-relaxed font-medium">
        Découvrez notre sélection pointue. Trouvez vos artistes, réservez vos accès.
      </p>
    </div>
  </div>

  <!-- Floating Minimalist Search Bar -->
  <div class="sticky top-[72px] z-40 bg-white/80 backdrop-blur-xl border-y border-gray-200 py-4 mb-16 shadow-lg shadow-black/5">
    <div class="max-w-7xl mx-auto px-8">
      <form action="/concerts" method="GET" class="flex flex-wrap md:flex-nowrap items-center gap-6">
        
        <!-- Search Input -->
        <div class="flex items-center flex-1 min-w-[200px] border-b border-gray-300 focus-within:border-orange-500 transition-colors pb-2">
          <i data-lucide="search" class="w-4 h-4 text-gray-400 mr-3"></i>
          <input
            type="text"
            name="search"
            value="{{search}}"
            placeholder="Rechercher..."
            class="text-sm font-bold outline-none w-full bg-transparent placeholder-gray-400 text-black"
          >
        </div>

        <!-- Filters -->
        <div class="flex items-center gap-6 flex-wrap md:flex-nowrap">
          <div class="flex items-center border-b border-gray-300 focus-within:border-orange-500 transition-colors pb-2">
            <i data-lucide="music" class="w-4 h-4 text-gray-400 mr-2"></i>
            <select name="genre_id" class="bg-transparent text-sm font-bold outline-none cursor-pointer appearance-none pr-6 text-gray-600 focus:text-black">
              <option value="" class="bg-white text-black">Tous les genres</option>
              {{#each genres}}
                <option value="{{this._id}}" class="bg-white text-black" {{#if (eq this._id ../selectedGenre)}}selected{{/if}}>
                  {{this.name}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="flex items-center border-b border-gray-300 focus-within:border-orange-500 transition-colors pb-2">
            <i data-lucide="mic" class="w-4 h-4 text-gray-400 mr-2"></i>
            <select name="band_id" class="bg-transparent text-sm font-bold outline-none cursor-pointer appearance-none pr-6 text-gray-600 focus:text-black">
              <option value="" class="bg-white text-black">Tous les artistes</option>
              {{#each bands}}
                <option value="{{this._id}}" class="bg-white text-black" {{#if (eq this._id ../selectedBand)}}selected{{/if}}>
                  {{this.name}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="flex items-center border-b border-gray-300 focus-within:border-orange-500 transition-colors pb-2">
            <i data-lucide="calendar" class="w-4 h-4 text-gray-400 mr-2"></i>
            <input
              type="date"
              name="date"
              value="{{selectedDate}}"
              class="bg-transparent text-sm font-bold outline-none cursor-pointer text-gray-600 focus:text-black"
            >
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 ml-auto pb-2">
          <a href="/concerts" class="text-xs font-mono uppercase tracking-widest text-gray-500 hover:text-black transition">Clear</a>
          <button type="submit" class="bg-orange-600 text-white text-xs font-black uppercase tracking-widest px-6 py-2 hover:bg-orange-700 hover:shadow-[0_10px_20px_rgba(234,88,12,0.3)] hover:-translate-y-0.5 transition-all rounded-sm">
            Filtrer
          </button>
        </div>

      </form>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-8">
    {{#if concerts}}
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-8 gap-y-16 mb-20">
        {{#each concerts}}
          <a href="/concerts/{{this._id}}" class="group relative block w-full aspect-[4/5] overflow-hidden bg-white shadow-xl shadow-black/5 hover:shadow-2xl hover:shadow-black/10 hover:-translate-y-2 transition-all duration-500 rounded-md">
            <img src="{{this.image}}" alt="{{this.title}}" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-110 group-hover:opacity-100 transition-all duration-700 ease-out">
            
            <!-- Dark Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
            
            <!-- Badges -->
            <div class="absolute top-4 left-4 flex flex-col gap-2 z-10">
              {{#if this.availableTickets}}
                <span class="bg-orange-600 text-white text-[10px] font-black tracking-widest uppercase px-3 py-1 shadow-md">
                  En Vente
                </span>
              {{else}}
                <span class="bg-black/80 backdrop-blur-sm text-white text-[10px] font-mono tracking-widest uppercase px-3 py-1 border border-white/20">
                  Sold Out
                </span>
              {{/if}}
            </div>

            <!-- Details -->
            <div class="absolute bottom-0 left-0 w-full p-6 z-10">
              <div class="flex justify-between items-end mb-2">
                <p class="text-[10px] font-mono tracking-widest uppercase text-orange-500 drop-shadow-md">
                  {{this.band_id.name}}
                </p>
                <span class="text-sm font-black text-white drop-shadow-md">{{this.price}} FCFA</span>
              </div>
              <h3 class="font-black text-3xl tracking-tight text-white mb-3 leading-tight group-hover:text-orange-400 transition-colors drop-shadow-xl">
                {{this.title}}
              </h3>
              <div class="flex items-center justify-between text-[10px] text-gray-300">
                <span class="truncate flex items-center gap-1 opacity-80"><i data-lucide="map-pin" class="w-3 h-3"></i> {{this.location}}</span>
                <span class="truncate flex items-center gap-1 font-mono opacity-80"><i data-lucide="calendar" class="w-3 h-3"></i> {{this.formattedDate}}</span>
              </div>
            </div>
          </a>
        {{/each}}
      </div>

      <!-- Load More (Editorial) -->
      <div class="flex justify-center border-t border-gray-200 pt-16">
        <button class="text-sm font-mono uppercase tracking-widest border-b border-gray-300 pb-1 text-gray-500 hover:text-orange-600 hover:border-orange-600 transition-colors">
          Charger Plus
        </button>
      </div>

    {{else}}
      <!-- Empty State -->
      <div class="py-32 flex flex-col items-center justify-center text-center">
        <p class="font-mono text-xs uppercase tracking-widest text-orange-600 mb-6">Erreur 404_Like</p>
        <h3 class="text-4xl font-black tracking-tight text-black mb-4">SILENCE RADIO.</h3>
        <p class="text-gray-500 max-w-md mx-auto mb-8">Aucun événement ne correspond à ces critères. Redéfinissez votre recherche.</p>
        <a href="/concerts" class="bg-orange-600 text-white text-xs font-black uppercase tracking-widest px-8 py-3 hover:bg-orange-700 hover:shadow-[0_10px_20px_rgba(234,88,12,0.3)] hover:-translate-y-0.5 transition-all rounded-sm">
          Retour au programme
        </a>
      </div>
    {{/if}}

    <!-- THIS WEEK SECTION (More Compact, Minimal) -->
    {{#if thisWeekConcerts.length}}
      <div class="mt-32 pt-16 border-t border-gray-200">
        <div class="mb-10 flex justify-between items-end">
          <h2 class="text-4xl font-black tracking-tight text-black">CETTE SEMAINE</h2>
          <p class="font-mono text-xs uppercase tracking-widest text-orange-600">Curated picks</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {{#each thisWeekConcerts}}
            <a href="/concerts/{{this._id}}" class="group relative block aspect-square overflow-hidden bg-white shadow-xl shadow-black/5 hover:shadow-2xl hover:shadow-black/10 hover:-translate-y-2 transition-all duration-500 rounded-md">
              <img src="{{this.image}}" alt="{{this.title}}" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-110 group-hover:opacity-100 transition-transform duration-700 ease-out">
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
              
              <div class="absolute bottom-0 left-0 w-full p-4 z-10">
                <p class="text-[10px] font-mono tracking-widest uppercase text-orange-500 mb-1 drop-shadow-md">{{this.band_id.name}}</p>
                <h3 class="font-bold text-sm tracking-tight text-white truncate group-hover:text-orange-400 transition-colors drop-shadow-lg">{{this.title}}</h3>
              </div>
            </a>
          {{/each}}
        </div>
      </div>
    {{/if}}

  </div>
</div>
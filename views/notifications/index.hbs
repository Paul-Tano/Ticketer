<div class="min-h-screen bg-[#F8F9FA] font-sans text-gray-900 pb-24">
  <div class="max-w-4xl mx-auto pt-24 px-8">
    
    <div class="mb-16 border-b border-gray-200 pb-4">
      <p class="font-mono text-[10px] uppercase tracking-widest text-orange-600 mb-2 drop-shadow-sm">Centre de contrôle</p>
      <div class="flex justify-between items-end">
        <h1 class="text-5xl font-black tracking-tight text-black uppercase drop-shadow-sm">Notifications</h1>
        {{#if notifications.length}}
        <form action="/notifications/read-all" method="POST">
          <button type="submit" class="text-[10px] font-mono uppercase tracking-widest text-orange-600 hover:text-black transition-colors border-b border-transparent hover:border-black pb-0.5">
            Tout marquer comme lu
          </button>
        </form>
        {{/if}}
      </div>
    </div>

    <div class="bg-white border border-gray-200 shadow-xl shadow-black/5 rounded-md overflow-hidden">
      {{#if notifications.length}}
        <div class="divide-y divide-gray-100">
          {{#each notifications}}
            <div class="p-8 flex items-start gap-6 hover:bg-gray-50 transition-colors {{#unless this.read}}border-l-4 border-orange-500 bg-orange-50{{/unless}} relative group">
              <div class="w-12 h-12 bg-white border border-orange-200 flex-shrink-0 flex items-center justify-center rounded-sm">
                <i data-lucide="bell" class="w-5 h-5 text-orange-500"></i>
              </div>
              <div class="flex-1">
                <h4 class="font-black text-lg tracking-tight text-black mb-1 drop-shadow-sm">
                  {{#if this.concert_id}}
                    <a href="/concerts/{{this.concert_id._id}}" class="hover:underline hover:text-orange-600 transition-colors">
                      {{this.message}}
                    </a>
                  {{else}}
                    {{this.message}}
                  {{/if}}
                </h4>
                {{#if this.concert_id}}
                  <p class="text-sm text-gray-600 flex items-center gap-2 mt-2"><i data-lucide="map-pin" class="w-4 h-4"></i> {{this.concert_id.location}}</p>
                {{/if}}
                <p class="font-mono text-[10px] uppercase tracking-widest text-gray-400 mt-4">{{this.createdAt}}</p>
              </div>
              <div class="flex items-center gap-4 opacity-0 group-hover:opacity-100 transition-opacity">
                {{#unless this.read}}
                <form action="/notifications/{{this._id}}/read" method="POST">
                  <button type="submit" class="text-[10px] font-mono uppercase tracking-widest px-4 py-2 border border-gray-300 hover:border-black transition-colors bg-white">
                    Lu
                  </button>
                </form>
                {{/unless}}
                <form action="/notifications/delete/{{this._id}}" method="POST">
                  <button type="submit" class="text-gray-400 hover:text-red-500 transition-colors p-2" title="Supprimer">
                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                  </button>
                </form>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="p-20 flex flex-col items-center justify-center text-center">
          <div class="w-16 h-16 border border-gray-200 bg-[#F8F9FA] flex items-center justify-center mb-6 rounded-full">
            <i data-lucide="bell-off" class="w-6 h-6 text-gray-400"></i>
          </div>
          <p class="font-mono text-xs uppercase tracking-widest text-gray-500">Aucune nouvelle activité</p>
        </div>
      {{/if}}
    </div>

  </div>
</div>

<div class="min-h-screen bg-[#F4F4F4] font-sans">
  
  <!-- Hero Section -->
  <div class="relative h-[60vh] w-full bg-black flex items-end">
    {{#if band.image}}
      <img src="{{band.image}}" alt="{{band.name}}" class="absolute inset-0 w-full h-full object-cover opacity-60">
    {{else}}
      <div class="absolute inset-0 bg-gray-900 opacity-60"></div>
    {{/if}}
    <div class="absolute inset-0 bg-gradient-to-t from-[#F4F4F4] via-[#F4F4F4]/50 to-transparent"></div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-8 w-full pb-16 flex justify-between items-end">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-orange-600 mb-4 font-bold">Artiste</p>
        <h1 class="text-6xl md:text-8xl font-black tracking-tighter uppercase text-white drop-shadow-sm">{{band.name}}</h1>
      </div>
      
      {{#if user}}
      <div>
        <form action="/users/favorites/{{band._id}}/toggle" method="POST">
          <button type="submit" class="group flex items-center gap-3 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/30 px-6 py-4 rounded-full transition-all">
            {{#if isFavorite}}
              <i data-lucide="heart" class="w-6 h-6 text-red-500 fill-red-500"></i>
              <span class="text-white font-bold uppercase tracking-widest text-xs">Retirer des favoris</span>
            {{else}}
              <i data-lucide="heart" class="w-6 h-6 text-white group-hover:text-red-500 transition-colors"></i>
              <span class="text-white font-bold uppercase tracking-widest text-xs">Ajouter aux favoris</span>
            {{/if}}
          </button>
        </form>
      </div>
      {{/if}}
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-8 py-16 flex flex-col lg:flex-row gap-16">
    
    <!-- Left Col: Bio -->
    <div class="lg:w-1/3">
      <div class="sticky top-[100px]">
        <h2 class="font-mono text-[10px] uppercase tracking-widest text-gray-500 mb-6">Biographie</h2>
        {{#if band.description}}
          <div class="prose prose-sm text-gray-700">
            <p>{{band.description}}</p>
          </div>
        {{else}}
          <p class="text-sm text-gray-400 italic">Aucune biographie disponible pour le moment.</p>
        {{/if}}
      </div>
    </div>

    <!-- Right Col: Concerts -->
    <div class="lg:w-2/3">
      <h2 class="font-mono text-[10px] uppercase tracking-widest text-gray-500 mb-10 flex items-center gap-4">
        Événements à venir
        <span class="h-px bg-gray-300 flex-1"></span>
      </h2>

      <div class="space-y-6">
        {{#each concerts}}
          <a href="/concerts/{{this._id}}" class="group block bg-white border border-gray-200 p-6 hover:border-black transition-colors relative overflow-hidden flex flex-col sm:flex-row gap-6 items-center">
            
            <div class="w-full sm:w-1/4">
              <p class="text-xs font-mono uppercase tracking-widest text-orange-600 mb-1">{{this.genre_id.name}}</p>
              <p class="text-2xl font-black tracking-tight uppercase text-black">{{this.formattedDate}}</p>
            </div>
            
            <div class="w-full sm:w-2/4">
              <h3 class="text-xl font-bold uppercase text-black mb-1 group-hover:text-orange-600 transition-colors">{{this.title}}</h3>
              <p class="text-sm text-gray-500 flex items-center gap-2"><i data-lucide="map-pin" class="w-4 h-4"></i> {{this.location}}</p>
            </div>
            
            <div class="w-full sm:w-1/4 text-right">
              {{#if this.isSoldOut}}
                <span class="inline-block px-4 py-2 bg-gray-200 text-gray-500 font-bold uppercase tracking-widest text-[10px]">Complet</span>
              {{else}}
                <p class="text-xl font-black text-black mb-1">{{this.price}} FCFA</p>
                <p class="font-mono text-[9px] uppercase tracking-widest text-gray-400 group-hover:text-black transition-colors">Réserver  </p>
              {{/if}}
            </div>
          </a>
        {{else}}
          <div class="bg-white border border-gray-200 p-12 text-center">
            <i data-lucide="calendar-x" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
            <p class="font-mono text-xs uppercase tracking-widest text-gray-500">Aucun concert prévu pour cet artiste.</p>
          </div>
        {{/each}}
      </div>
    </div>
    
  </div>
</div>
